HOST.Cols = {}
HOST.OnScroll = {}
HOST.SecStart = {}
local GAP_X, GAP_Y, PAD_X, DESIGN_H = 14, 12, 26, 372
local curSection = 0

local function paintSection(i)
    pageTitle.Text = SECTIONS[i].title
    pageSub.Text = SECTIONS[i].sub
end

local function updateSection()
    local pos = Scroll.CanvasPosition.X
    local vw = Scroll.AbsoluteSize.X
    local maxX = math.max(0, Scroll.CanvasSize.X.Offset - vw)
    local probe = pos + math.min(vw * 0.3, 260)
    local idx = 1
    for k = 1, #SECTIONS do
        local sx = HOST.SecStart[k]
        if sx and sx - 10 <= probe then idx = k end
    end
    if maxX > 0 and pos >= maxX - 4 then
        for k = #SECTIONS, 1, -1 do
            if HOST.SecStart[k] then idx = k break end
        end
    end
    if idx ~= curSection then
        curSection = idx
        paintSection(idx)
    end
    for _, fn in ipairs(HOST.OnScroll) do pcall(fn) end
end
Scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(updateSection)

function HOST.ScrollTo(x, instant)
    local maxX = math.max(0, Scroll.CanvasSize.X.Offset - Scroll.AbsoluteSize.X)
    x = math.clamp(x, 0, maxX)
    if instant then
        Scroll.CanvasPosition = Vector2.new(x, 0)
    else
        tween(Scroll, 0.4, { CanvasPosition = Vector2.new(x, 0) })
    end
end

function HOST.JumpSection(i, instant)
    local sx = HOST.SecStart[i]
    if sx then HOST.ScrollTo(sx - PAD_X, instant) end
end
HOST.SetPage = function(i) HOST.JumpSection(i) end
