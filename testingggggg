local function syncDirectory()
	local extra = dirSync > 0 and ('orderBy="upd"&startAt=' .. tostring(dirSync + 1)) or nil
	local ok, data, _, code = dbRequest("GET", "/profiles", nil, auth, FIREBASE_DB, extra)
	if not ok and code == 400 and extra then ok, data = dbRequest("GET", "/profiles", nil, auth, FIREBASE_DB) end
	if not ok or type(data) ~= "table" then return end
	local maxUpd = dirSync
	for id, p in pairs(data) do
		if type(p) == "table" and tostring(id):match("^%d+$") then
			directory[tostring(id)] = { d = cut(tostring(p.dn or ""), 40), n = cut(tostring(p.un or ""), 40) }
