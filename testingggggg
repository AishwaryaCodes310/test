    local function setFooter(t) footer.Text = tostring(t) end
    local function clipboard(value)
        local fn = setclipboard or toclipboard or (syn and syn.write_clipboard)
        if type(fn) == "function" then
            local ok = pcall(fn, tostring(value))
            if ok then setFooter("Copied: " .. tostring(value):sub(1, 90)); return true end
        end
        setFooter(tostring(value))
        return false
    end
    local function getRoot()
        local c = LP.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end
    local function findTarget()
        local q = target.Text:gsub("^%s+", ""):gsub("%s+$", "")
        if q == "" then setFooter("Enter a player username or display name in the player field first."); return nil end
        q = q:lower()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Name:lower() == q or plr.DisplayName:lower() == q then return plr end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Name:lower():find(q, 1, true) or plr.DisplayName:lower():find(q, 1, true) then return plr end
        end
        setFooter("No matching player found in this server.")
        return nil
    end
    local previousCameraSubject
    local function stopSpectating()
        local cam = workspace.CurrentCamera
        if cam then
            local char = LP.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            cam.CameraSubject = hum or previousCameraSubject
        end
        previousCameraSubject = nil
        setFooter("Camera returned to your character.")
    end
    local function spectate()
        local plr = findTarget(); if not plr then return end
        local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
        if not hum then setFooter("That player's character is not available yet."); return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        if not previousCameraSubject then previousCameraSubject = cam.CameraSubject end
        cam.CameraSubject = hum
        setFooter("Now spectating " .. plr.DisplayName .. " (local camera only).")
    end

    local hud
    local function toggleHud()
