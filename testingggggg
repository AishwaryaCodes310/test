		for i = 1, N do
			hist[i] = 0
			local bar = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new((i - 1) / N, 1, 1, 0), Size = UDim2.new(1 / N, -2, 0.04, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, graph)
