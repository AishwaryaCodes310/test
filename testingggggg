    end)

    -- Compact, touch-friendly performance panel. Tap its X to hide it.
    hud = make("Frame", { Name = "SaikiPerformanceHUD", AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.new(0, 12, 0, 82), Size = UDim2.fromOffset(210, 104),
        BackgroundColor3 = bg, BackgroundTransparency = 0.06, Visible = state.hud, ZIndex = 270 }, HOST.Gui)
    make("UICorner", { CornerRadius = UDim.new(0, 12) }, hud)
    make("UIStroke", { Color = red, Transparency = 0.5 }, hud)
    make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 7), Size = UDim2.new(1, -42, 0, 16),
        Text = "SAIKI PERFORMANCE", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = red,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 271 }, hud)
    local hudClose = make("TextButton", { Position = UDim2.new(1, -29, 0, 4), Size = UDim2.fromOffset(24, 24),
        BackgroundColor3 = card, Text = "×", Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = white, ZIndex = 272 }, hud)
    make("UICorner", { CornerRadius = UDim.new(0, 7) }, hudClose)
    local hudStats = make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 28), Size = UDim2.new(1, -20, 1, -34),
        Text = "FPS: --\nPing: --\nMemory: -- MB", Font = Enum.Font.Code, TextSize = 12, TextColor3 = white,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 271 }, hud)
    hudClose.Activated:Connect(function() state.hud = false; hud.Visible = false; persist() end)
    local frames, elapsed = 0, 0
    local hudConn = RS.RenderStepped:Connect(function(dt)
        frames += 1; elapsed += dt
        if elapsed >= 0.75 then
            local fps = math.floor(frames / elapsed + 0.5); frames, elapsed = 0, 0
            if state.hud and hud.Parent then
                local ping, memory = "--", "--"
                pcall(function() ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValueString() end)
                pcall(function() memory = string.format("%.0f", Stats:GetTotalMemoryUsageMb()) end)
                hudStats.Text = "FPS: " .. tostring(fps) .. "\nPing: " .. tostring(ping) .. "\nMemory: " .. tostring(memory) .. " MB"
            end
        end
    end)

    -- Drag the hub and HUD using mouse or touch; this is intentionally not keyboard-only.
    local dragConnections = {}
    local function makeDraggable(handle, object)
        local dragging, dragInput, startPos, objectPos = false, nil, nil, nil
        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true; dragInput = input; startPos = input.Position; objectPos = object.Position
                input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
            end
        end)
        handle.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
        end)
        dragConnections[#dragConnections + 1] = UIS.InputChanged:Connect(function(input)
            if dragging and (input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement) then
                local delta = input.Position - startPos
                object.Position = UDim2.new(objectPos.X.Scale, objectPos.X.Offset + delta.X, objectPos.Y.Scale, objectPos.Y.Offset + delta.Y)
            end
        end)
    end
    makeDraggable(header, panel)
    makeDraggable(hud:FindFirstChildWhichIsA("TextLabel"), hud)

    -- Desktop shortcuts are optional; mobile users can use the always-visible TOOLS button.
    local inputConn = UIS.InputBegan:Connect(function(input, processed)
        if processed or UIS:GetFocusedTextBox() then return end
        if input.KeyCode == state.paletteKey then panel.Visible = not panel.Visible
        elseif input.KeyCode == state.hudKey then toggleHud() end
    end)
    HOST.Gui.Destroying:Connect(function()
        pcall(function() hudConn:Disconnect() end)
        pcall(function() inputConn:Disconnect() end)
        for _, connection in ipairs(dragConnections) do pcall(function() connection:Disconnect() end) end
    end)
    rebuild()
    state.hud = state.hud == true
    hud.Visible = state.hud
    persist()
    HOST.CommandCenter = { Toggle = function() panel.Visible = not panel.Visible end,
        Open = function() panel.Visible = true end, ToggleHUD = toggleHud, Profiles = state.profiles }
end)()

