			low = low:gsub("^@", "")
			for _, p in ipairs(Players:GetPlayers()) do
				local nm, dn = p.Name:lower(), p.DisplayName:lower()
				local hit = low == "" or nm:sub(1, #low) == low or dn:sub(1, #low) == low
					or (#low >= 2 and (nm:find(low, 1, true) ~= nil or dn:find(low, 1, true) ~= nil))
				local protected = (cmd == "!saikikick" or cmd == "!saikimute") and T.isMod(p.UserId)
				if hit and not protected then
