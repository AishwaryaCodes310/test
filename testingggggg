				bar.BackgroundColor3 = colFor(hist[i])
			end
			tAcc, frames = 0, 0
		end))
	end

	------------------------------------------------------------- SKY STYLES page
	local function period(h)
		if h < 5.5 or h >= 19.5 then return "Night" end
		if h < 7.5 then return "Dawn" end
		if h >= 16.5 then return "Dusk" end
		return "Day"
	end
	local function hashOf(s)
		local h = 7
		for i = 1, #s do h = (h * 31 + string.byte(s, i)) % 100003 end
		return h
	end

	-- draws a small picture of the sky style (or shows your uploaded cover image)
	local function buildCover(parent, name)
		for _, ch in ipairs(parent:GetChildren()) do
			if ch:IsA("GuiObject") or ch:IsA("UIGradient") then ch:Destroy() end
		end
		local id = COVER_IDS[name]
		if id and id ~= "" then
			new("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = "rbxassetid://" .. id, ScaleType = Enum.ScaleType.Crop }, parent)
			return
		end
		local pr = SKY_PRESETS[name]
		if not pr then return end
		local hr = pr.hour or 12
		local night = hr < 5.5 or hr >= 19.5
		local twi = (not night) and (hr < 7.5 or hr >= 16.5)
		local top, bot
		if night then
			top = pr.adec:Lerp(Color3.new(0, 0, 0), 0.55)
			bot = pr.acol:Lerp(Color3.new(0, 0, 0), 0.45)
		elseif twi then
			top = pr.adec:Lerp(Color3.fromRGB(40, 40, 90), 0.5)
			bot = pr.acol
		else
			top = pr.acol:Lerp(Color3.fromRGB(80, 130, 225), 0.3)
			bot = pr.adec:Lerp(WHITE, 0.1)
		end
		parent.BackgroundColor3 = WHITE
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(top, bot) }, parent)
		local rng = Random.new(hashOf(name))
		local function box(x, y, w, h, c, tr, round)
			local f = new("Frame", { Position = UDim2.fromScale(x, y), Size = UDim2.fromScale(w, h), BackgroundColor3 = c, BackgroundTransparency = tr or 0, BorderSizePixel = 0 }, parent)
			if round then new("UICorner", { CornerRadius = UDim.new(0, 999) }, f) end
			return f
		end
		-- soft colour clouds of gas on hazy nights (galaxy, nebula, neon...)
		if night and pr.haze >= 0.8 then
			box(rng:NextNumber(0, 0.3), rng:NextNumber(0, 0.2), 0.6, 0.8, pr.ccol, 0.82, true)
			box(rng:NextNumber(0.4, 0.6), rng:NextNumber(0.1, 0.3), 0.5, 0.7, pr.acol, 0.84, true)
		end
		-- stars
		if (night or twi) and pr.stars > 0 then
			local n = math.floor(math.clamp(pr.stars / 330, 3, 18))
			if not night then n = math.floor(n / 2) end
			for _ = 1, n do
				local sz = rng:NextInteger(1, 2)
				local f = box(rng:NextNumber(0.03, 0.97), rng:NextNumber(0.04, 0.55), 0, 0, WHITE, rng:NextNumber(0, 0.5), true)
				f.Size = UDim2.fromOffset(sz, sz)
			end
		end
		if name == "Aurora" then
			local a1 = box(0.05, 0.16, 0.9, 0.22, Color3.fromRGB(90, 255, 190), 0.55, true)
			a1.Rotation = -8
			new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 1) }) }, a1)
			local a2 = box(0.15, 0.3, 0.7, 0.14, Color3.fromRGB(120, 200, 255), 0.7, true)
			a2.Rotation = -6
		end
		-- moon at night, sun by day
		local function disc(x, y, d, c, glow)
			local g = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y), Size = UDim2.fromOffset(d * glow, d * glow), BackgroundColor3 = c, BackgroundTransparency = 0.84, BorderSizePixel = 0 }, parent)
			new("UICorner", { CornerRadius = UDim.new(0, 999) }, g)
			local m = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y), Size = UDim2.fromOffset(d, d), BackgroundColor3 = c, BorderSizePixel = 0 }, parent)
			new("UICorner", { CornerRadius = UDim.new(0, 999) }, m)
		end
		if hr >= 18.5 or hr < 5.5 then
			local d = math.clamp(10 + (pr.moon or 11) * 0.55, 14, 34)
			disc(0.74, 0.24, d, (name == "Blood Moon") and Color3.fromRGB(220, 70, 60) or Color3.fromRGB(236, 240, 252), 2.2)
		elseif hr >= 5.8 and hr < 18.2 then
			local x = math.clamp((hr - 5) / 14, 0.1, 0.9)
			local y = 0.64 - 0.46 * math.sin(math.clamp((hr - 6) / 12, 0, 1) * math.pi)
			disc(x, y, 18, twi and Color3.fromRGB(255, 205, 130) or Color3.fromRGB(255, 246, 205), 2.6)
		end
		-- clouds
		local puffs = math.floor(pr.cover * 4 + 0.5)
		local ctr = 0.12 + (1 - pr.cdens) * 0.4
		for i = 1, puffs do
			local x = ((i - 1) / math.max(puffs, 1)) * 0.8 + rng:NextNumber(-0.02, 0.1)
			local y = rng:NextNumber(0.28, 0.5)
			box(x, y, 0.26, 0.07, pr.ccol, ctr, true)
			box(x + 0.04, y - 0.045, 0.11, 0.08, pr.ccol, ctr, true)
			box(x + 0.12, y - 0.06, 0.12, 0.09, pr.ccol, ctr, true)
		end
		if name == "Rainbow Day" then
			local cl = { Color3.fromRGB(255, 80, 80), Color3.fromRGB(255, 170, 60), Color3.fromRGB(255, 235, 90), Color3.fromRGB(90, 210, 120), Color3.fromRGB(90, 150, 255) }
			for i, c in ipairs(cl) do
				local arc = new("Frame", { Position = UDim2.fromScale(0.1 + (i - 1) * 0.025, 0.3 + (i - 1) * 0.04), Size = UDim2.fromScale(0.8 - (i - 1) * 0.05, 1.2), BackgroundTransparency = 1, BorderSizePixel = 0 }, parent)
				new("UICorner", { CornerRadius = UDim.new(0, 999) }, arc)
				new("UIStroke", { Color = c, Thickness = 3, Transparency = 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, arc)
			end
