    -- Save the current settings file under a user-named local profile.
    saveProfile.Activated:Connect(function()
        local name = profileName.Text:gsub("[^%w _%-]", ""):sub(1, 28)
        if name == "" then setFooter("Type a profile name first."); return end
        local raw
        pcall(function() if isfile and readfile and isfile(settingsFile) then raw = readfile(settingsFile) end end)
        if not raw then setFooter("Saiki settings file not found yet; change/save a setting first."); return end
        state.profiles[name] = raw; persist(); setFooter("Saved profile: " .. name); rebuild()
    end)
