        if isfile and readfile and isfile(addonFile) then
            local d = HttpService:JSONDecode(readfile(addonFile))
            if type(d) == "table" then
                if type(d.paletteKey) == "string" and Enum.KeyCode[d.paletteKey] then state.paletteKey = Enum.KeyCode[d.paletteKey] end
                if type(d.hudKey) == "string" and Enum.KeyCode[d.hudKey] then state.hudKey = Enum.KeyCode[d.hudKey] end
                if type(d.hud) == "boolean" then state.hud = d.hud end
                if type(d.profiles) == "table" then state.profiles = d.profiles end
            end
        end
    end)
