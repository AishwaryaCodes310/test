    addCommand("FOV: Wide (90)", "Set your local camera field of view to 90", function() local cam = workspace.CurrentCamera; if cam then cam.FieldOfView = 90; setFooter("Camera FOV set to 90.") end end, "camera zoom fov wide", "Camera")
    addCommand("FOV: Narrow (55)", "Set your local camera field of view to 55", function() local cam = workspace.CurrentCamera; if cam then cam.FieldOfView = 55; setFooter("Camera FOV set to 55.") end end, "camera zoom fov narrow", "Camera")

    local rebuild
    local function addProfileCommands(out)
        for profileName, raw in pairs(state.profiles) do
            local savedName, savedRaw = profileName, raw
            out[#out + 1] = { name = "Load Profile: " .. savedName,
                detail = "Restore the saved Saiki settings file (re-run Saiki to apply)", keywords = "profile preset config settings load",
                action = function()
                    if type(savedRaw) ~= "string" then setFooter("Profile data is invalid."); return end
                    local ok = pcall(function() if not writefile then error("writefile unavailable") end; writefile(settingsFile, savedRaw) end)
                    setFooter(ok and ("Restored profile '" .. savedName .. "'. Re-run Saiki Rechat to apply it.") or "Could not restore this profile on this executor.")
                end }
            out[#out + 1] = { name = "Delete Profile: " .. savedName, detail = "Remove this saved profile", keywords = "profile remove delete",
                action = function() state.profiles[savedName] = nil; persist(); setFooter("Deleted profile '" .. savedName .. "'."); rebuild() end }
        end
    end
    rebuild = function()
        for _, child in ipairs(rows:GetChildren()) do if child:IsA("TextButton") or child:IsA("Frame") then child:Destroy() end end
        local q = search.Text:lower()
        local visible = table.clone(commands)
        addProfileCommands(visible)
        local count = 0
        for _, item in ipairs(visible) do
            if q == "" or item.name:lower():find(q, 1, true) or item.detail:lower():find(q, 1, true) or item.keywords:find(q, 1, true) then
                count += 1
                local b = make("TextButton", { Name = "Command_" .. count, Size = UDim2.new(1, -2, 0, isTouch and 64 or 56),
                    BackgroundColor3 = card, Text = "", AutoButtonColor = true, LayoutOrder = count, ZIndex = 302 }, rows)
                make("UICorner", { CornerRadius = UDim.new(0, 10) }, b)
                make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(13, 8), Size = UDim2.new(1, -26, 0, 20),
                    Text = item.name, Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = white,
                    TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 303 }, b)
                make("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(13, 31), Size = UDim2.new(1, -26, 0, 25),
                    Text = item.detail, Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = muted,
                    TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
                    TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 303 }, b)
                b.Activated:Connect(function()
                    local ok, err = pcall(item.action)
                    if not ok then setFooter("Command error: " .. tostring(err):sub(1, 100)) end
                end)
            end
        end
        rows.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 4)
        if count == 0 then setFooter("No matching commands. Try a shorter search.") end
    end
    search:GetPropertyChangedSignal("Text"):Connect(rebuild)
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() rows.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 4) end)
