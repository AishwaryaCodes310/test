				end
			end
		elseif cmd == "!saikicustomtitle" then
			if low == "" or ("off"):sub(1, #low) == low then out[#out + 1] = { label = "off (remove tag)", fill = cmd .. " " .. first .. " off" } end
		end
		return out
	end

