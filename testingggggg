function HOST.Relayout()
    local gs = HOST.Gui.AbsoluteSize
    if gs.X <= 0 or gs.Y <= 0 then
        local cam = workspace.CurrentCamera
        gs = cam and cam.ViewportSize or Vector2.new(1280, 720)
    end
    local compact = gs.Y < 560
    local topH = compact and 58 or 84
    local botH = topH -- no bottom bar any more: same space above and below, so the cards sit centred
    pageTitle.Position = UDim2.fromOffset(34, compact and 8 or 26)
    pageTitle.TextSize = compact and 20 or 24
    pageSub.Position = UDim2.fromOffset(35, compact and 34 or 56)
    Scroll.Position = UDim2.fromOffset(0, topH)
    Scroll.Size = UDim2.new(1, 0, 1, -(topH + botH))

    local A = math.max(160, gs.Y - topH - botH - 12)
    local s = math.clamp(A / DESIGN_H, 0.5, 1)
    local x = PAD_X
    table.clear(HOST.SecStart)
    for _, col in ipairs(HOST.Cols) do
        if #col.cards > 0 then
            if not HOST.SecStart[col.section] then HOST.SecStart[col.section] = x end
            local cw = col.w * s
            local fixedSum, flexN = 0, 0
            for _, c in ipairs(col.cards) do
                if type(c.h) == "number" then fixedSum += c.h * s else flexN += 1 end
            end
            local gaps = (#col.cards - 1) * GAP_Y * s
            local flexH = flexN > 0 and math.max(70 * s, (A - fixedSum - gaps) / flexN) or 0
            local total = fixedSum + gaps + flexH * flexN
            local y = 3
            if col.valign ~= "top" then y = 3 + math.max(0, (A - total) / 2) end
            for _, c in ipairs(col.cards) do
                local h = (type(c.h) == "number") and (c.h * s) or flexH
                c.frame.Position = UDim2.fromOffset(x, y)
                c.frame.Size = UDim2.fromOffset(cw, h)
                c.stage.Size = UDim2.fromOffset(cw / s, h / s)
                c.scale.Scale = s
                y += h + GAP_Y * s
            end
            x += cw + GAP_X
        end
    end
    Scroll.CanvasSize = UDim2.fromOffset(math.max(0, x - GAP_X + PAD_X), 0)
    local maxX = math.max(0, Scroll.CanvasSize.X.Offset - Scroll.AbsoluteSize.X)
    if Scroll.CanvasPosition.X > maxX then Scroll.CanvasPosition = Vector2.new(maxX, 0) end
    updateSection()
end

local layoutQueued = false
local function queueRelayout()
    if layoutQueued then return end
    layoutQueued = true
    task.defer(function()
        layoutQueued = false
        HOST.Relayout()
    end)
end
HOST.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(queueRelayout)
pcall(function()
    local cam = workspace.CurrentCamera
    if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(queueRelayout) end
end)

-- a column is a vertical stack of cards; cards are the boxes of the collage
function HOST.Column(section, width, valign)
    local col = { section = section, w = width, valign = valign, cards = {} }
    HOST.Cols[#HOST.Cols + 1] = col
    -- h = fixed height in design units, or nil to fill what is left of the column
    function col.Card(h, name, plain)
        local card = Instance.new("Frame")
        card.Name = name or "Card"
        card.BackgroundColor3 = SAIKIUI.card
        card.BackgroundTransparency = 0.1
        card.BorderSizePixel = 0
        card.ClipsDescendants = not plain
        card.ZIndex = 6
        card.Parent = Scroll
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 18)
        local st = Instance.new("UIStroke", card)
        st.Color = Color3.new(1, 1, 1)
        st.Transparency = 0.9
        st.Thickness = 1
        local stage = Instance.new("Frame")
        stage.Name = "Stage"
        stage.BackgroundTransparency = 1
        stage.BorderSizePixel = 0
        stage.Size = UDim2.fromScale(1, 1)
        stage.Parent = card
        local us = Instance.new("UIScale")
        us.Parent = stage
        local c = { frame = card, stage = stage, scale = us, h = h }
        col.cards[#col.cards + 1] = c
        HOST.Relayout()
        return stage, c
    end
    return col
end

function HOST.RemoveColumns(list)
    for _, col in ipairs(list) do
        for _, c in ipairs(col.cards) do
            pcall(function() c.frame:Destroy() end)
        end
        col.cards = {}
        for k, v in ipairs(HOST.Cols) do
            if v == col then table.remove(HOST.Cols, k) break end
        end
    end
    HOST.Relayout()
end

-- shift + mouse wheel slides the sheet on PC
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseWheel or not HOST.Sheet.Visible then return end
    if not (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)) then return end
    local m = UserInputService:GetMouseLocation()
    local p, sz = Scroll.AbsolutePosition, Scroll.AbsoluteSize
    if m.X >= p.X and m.X <= p.X + sz.X and m.Y >= p.Y and m.Y <= p.Y + sz.Y then
        HOST.ScrollTo(Scroll.CanvasPosition.X - input.Position.Z * 140, true)
    end
end)

