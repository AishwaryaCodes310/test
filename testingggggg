            keywords = (keywords or ""):lower(), category = category or "General" }
    end
    addCommand("Open Chat and DMs", "Open Saiki's existing chat and direct messages", function() HOST.SetPage(1); HOST.SetVisible(true); panel.Visible = false end, "server messages private dm inbox", "Navigation")
    addCommand("Open Graphics", "Open the existing Saiki GFX controls", function() HOST.SetPage(2); HOST.SetVisible(true); panel.Visible = false end, "gfx visuals graphics fps", "Navigation")
    addCommand("Open Sky Styles", "Open the existing sky-style controls", function() HOST.SetPage(3); HOST.SetVisible(true); panel.Visible = false end, "sky atmosphere lighting", "Navigation")
    addCommand("Hide / Show Saiki", "Toggle the existing Saiki interface", function() HOST.SetVisible(not HOST.Sheet.Visible); panel.Visible = false end, "hide show toggle gui window", "Navigation")
    addCommand("Performance HUD", "Show or hide FPS, ping and memory", toggleHud, "fps ping memory stats monitor", "Performance")
