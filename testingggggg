local visible = true
local hiddenByToggle = {}
function HOST.SetVisible(v)
    visible = v
    HOST.Sheet.Visible = v
    if not v then
        table.clear(hiddenByToggle)
        for _, child in ipairs(HOST.Gui:GetChildren()) do
            if child ~= Toggle and child ~= HOST.Sheet and child:IsA("GuiObject") and child.Visible then
                hiddenByToggle[child] = true
                child.Visible = false
            end
        end
    else
        for child in pairs(hiddenByToggle) do
            if child.Parent then child.Visible = true end
        end
        table.clear(hiddenByToggle)
    end
end
Toggle.Activated:Connect(function()
    HOST.SetVisible(not visible)
end)

function HOST.Report(name, err)
    local msg = "[SAIKI] " .. tostring(name) .. " failed to load:\n" .. tostring(err)
    pcall(function() warn(msg) end)
    pcall(function()
        local box = Instance.new("TextButton")
        box.Name = "SaikiError_" .. tostring(name)
        box.AutoButtonColor = false
        box.BackgroundColor3 = Color3.fromRGB(40, 10, 14)
        box.BackgroundTransparency = 0.1
        box.BorderSizePixel = 0
        box.Position = UDim2.fromOffset(34, 84 + (HOST.ErrCount or 0) * 130)
        box.Size = UDim2.fromOffset(460, 122)
        box.Text = string.sub(msg, 1, 420)
        box.TextSize = 11
        box.Font = Enum.Font.Code
        box.TextColor3 = Color3.fromRGB(255, 200, 205)
        box.TextWrapped = true
        box.TextXAlignment = Enum.TextXAlignment.Left
        box.TextYAlignment = Enum.TextYAlignment.Top
        box.ZIndex = 900
        box.Parent = HOST.Gui
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 12)
        local pad = Instance.new("UIPadding", box)
        pad.PaddingLeft = UDim.new(0, 10)
        pad.PaddingTop = UDim.new(0, 8)
        pad.PaddingRight = UDim.new(0, 10)
        box.Activated:Connect(function() box:Destroy() end)
        HOST.ErrCount = (HOST.ErrCount or 0) + 1
    end)
end

function HOST.Run(name, fn)
    local ok, err = xpcall(fn, function(e)
        return tostring(e) .. "\n" .. tostring(debug.traceback())
    end)
    if not ok then HOST.Report(name, err) end
end

function HOST.Start()
    HOST.Sheet.Visible = true
    HOST.Relayout()
    HOST.JumpSection(1, true)
end


