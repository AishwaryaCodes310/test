        pcall(function()
            if writefile then
                if isfolder and not isfolder(folder) and makefolder then makefolder(folder) end
                writefile(addonFile, HttpService:JSONEncode({ paletteKey = state.paletteKey.Name, hudKey = state.hudKey.Name, hud = state.hud, profiles = state.profiles }))
            end
        end)
    end
