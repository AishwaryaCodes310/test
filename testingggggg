			if v >= 55 then return Color3.fromRGB(40, 200, 110) elseif v >= 30 then return Color3.fromRGB(240, 170, 30) end
			return Color3.fromRGB(255, 80, 90)
		end
		local tAcc, frames = 0, 0
		track(RS.Heartbeat:Connect(function(dt)
			tAcc = tAcc + dt
			frames = frames + 1
			if tAcc < 0.25 then return end
			local f = math.floor(frames / tAcc + 0.5)
			table.remove(hist, 1)
			table.insert(hist, f)
			local mn, mx, sum, cnt = math.huge, 0, 0, 0
			for _, v in ipairs(hist) do
				if v > 0 then
					mn = math.min(mn, v)
					mx = math.max(mx, v)
					sum = sum + v
					cnt = cnt + 1
				end
			end
			if cnt == 0 then mn = 0 end
			local avg = cnt > 0 and math.floor(sum / cnt + 0.5) or 0
			fpsNum.Text = f .. " FPS"
			fpsNum.TextColor3 = colFor(f)
			fpsStat.Text = "MIN " .. mn .. "   AVG " .. avg .. "   MAX " .. mx .. "   " .. string.format("%.1f", 1000 / math.max(f, 1)) .. " ms"
