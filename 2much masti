-- corner radius per card (design units): big soft shapes next to tighter ones = the collage look.
-- short cards (message boxes, search, headers) automatically become pills.
local CARD_R = {
    ServerChat = 22, MessageBox = 22,
    DMSearch = 22, DMRecent = 24, DMServer = 30, DMHeader = 22, DMMessages = 18, DMMessageBox = 22,
    SetCategories = 28, SetMain = 18, SetQuick = 26, SetSupport = 30,
    GfxCategories = 28, GfxMain = 18, GfxQuick = 26, GfxFps = 30,
    SkyList = 20, SkyDetail = 28, SkyAdjust = 22,
    TrollNow = 26, TrollTarget = 24, TrollMain = 24, TrollSelf = 24, TrollHelp = 24, TrollStop = 24, TrollSmoke = 26,
    MusicMode = 22, MusicNowPlaying = 24, MusicQueue = 18, MusicLibrary = 18, MusicSave = 26, MusicPlayback = 26, MusicSearchKey = 22,
}

-- a column is a vertical stack of cards; cards are the boxes of the collage
function HOST.Column(section, width, valign)
    local col = { section = section, w = width, valign = valign, cards = {} }
    HOST.Cols[#HOST.Cols + 1] = col
    -- h = fixed height in design units, or nil to fill what is left of the column
    function col.Card(h, name, plain)
        local card = Instance.new("Frame")
        card.Name = name or "Card"
        card:SetAttribute("HostTheme", true) -- HOST.SetTheme owns this card (body, rim, shine)
        card.BackgroundColor3 = Color3.new(1, 1, 1) -- the body gradient below gives the colour
        card.BackgroundTransparency = 0.05
        card.BorderSizePixel = 0
        card.ClipsDescendants = not plain
        card.ZIndex = 6
        card.Parent = Scroll
        local cornerObj = Instance.new("UICorner", card)
        cornerObj.CornerRadius = UDim.new(0, 18)
        local shade = Instance.new("UIGradient", card)
        shade.Name = "Body"
        shade.Rotation = 90
        shade.Color = ColorSequence.new(HOST.Th.cardA, HOST.Th.cardB)
        local st = Instance.new("UIStroke", card)
        st.Color = HOST.Th.rim
        st.Transparency = 0
        local rimGrad = Instance.new("UIGradient", st)
        rimGrad.Rotation = 90
        rimGrad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.84), NumberSequenceKeypoint.new(0.5, 0.92), NumberSequenceKeypoint.new(1, 0.78),
        })
        st.Thickness = 1
        local stage = Instance.new("Frame")
        stage.Name = "Stage"
        stage.BackgroundTransparency = 1
        stage.BorderSizePixel = 0
        stage.Size = UDim2.fromScale(1, 1)
        stage.Parent = card
        local us = Instance.new("UIScale")
        us.Parent = stage
        -- soft white shine along the top edge (clipped to the card's rounded corners)
        local shine = Instance.new("Frame")
        shine.Name = "SurfaceShine"
        shine:SetAttribute("HostTheme", true)
        shine.BackgroundTransparency = 1
        shine.BorderSizePixel = 0
        shine.Size = UDim2.new(1, 0, 0, 46)
        shine.ZIndex = 3
        shine.Active = false
        pcall(function() shine.Interactable = false end)
        shine.Parent = card
        local shineCorner = Instance.new("UICorner", shine)
        local shineFill = Instance.new("Frame")
        shineFill.Name = "Fill"
        shineFill:SetAttribute("HostTheme", true)
        shineFill.Size = UDim2.fromScale(1, 1)
        shineFill.BackgroundColor3 = HOST.Th.shine
        shineFill.BackgroundTransparency = 0.84
        shineFill.BorderSizePixel = 0
        shineFill.Active = false
        shineFill.Parent = shine
        local fillCorner = Instance.new("UICorner", shineFill)
        local shineGrad = Instance.new("UIGradient", shineFill)
        shineGrad.Rotation = 90
        shineGrad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.14), NumberSequenceKeypoint.new(0.3, 0.62),
            NumberSequenceKeypoint.new(0.62, 0.94), NumberSequenceKeypoint.new(1, 1),
        })
        local c = { frame = card, stage = stage, scale = us, h = h, corner = cornerObj, r = CARD_R[name] or 18,
            shine = shine, shineCorner = shineCorner, fillCorner = fillCorner }
        col.cards[#col.cards + 1] = c
        HOST.Relayout()
        return stage, c
    end
    return col
end

function HOST.RemoveColumns(list)
    for _, col in ipairs(list) do
        for _, c in ipairs(col.cards) do
            pcall(function() c.frame:Destroy() end)
        end
        col.cards = {}
        for k, v in ipairs(HOST.Cols) do
            if v == col then table.remove(HOST.Cols, k) break end
        end
    end
    HOST.Relayout()
end

-- shift + mouse wheel slides the sheet on PC
UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseWheel or not HOST.Sheet.Visible then return end
    if not (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)) then return end
    local m = UserInputService:GetMouseLocation()
    local p, sz = Scroll.AbsolutePosition, Scroll.AbsoluteSize
    if m.X >= p.X and m.X <= p.X + sz.X and m.Y >= p.Y and m.Y <= p.Y + sz.Y then
        HOST.ScrollTo(Scroll.CanvasPosition.X - input.Position.Z * 140, true)
    end
end)

