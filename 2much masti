-- TOP-RIGHT TOOLS (Novoline-style): Speed, Jump, Fly, Go to player
-- A row of capsules sits in the top-right of the sheet. Click a name to switch
-- it on/off, use - / + (hold to repeat) to change the value. Fly: move with the
-- normal controls, the camera aims the flight; Space / E = up, Ctrl / Q = down.
-- Go to player: pick a name with the arrows, press Go.
-- Set HOST_OPTIONS = false to remove it.
----------------------------------------------------------------
local HOST_OPTIONS = true
if HOST_OPTIONS then
    local OPT = {
        speed = { on = false, v = 50, min = 16, max = 1000, step = 2 },
        jump = { on = false, v = 100, min = 50, max = 1000, step = 5 },
        fly = { on = false, v = 60, min = 20, max = 1000, step = 5 },
    }
    local function getHum()
        local c = LocalPlayer.Character
        return c and c:FindFirstChildOfClass("Humanoid")
    end
    local function getRoot()
        local c = LocalPlayer.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    -- ===== behaviour =====
    local orig = {}
    local bv, bg
    local function flyCleanup(resetStand)
        if bv then bv:Destroy() bv = nil end
        if bg then bg:Destroy() bg = nil end
        if resetStand then
            local h = getHum()
            if h then h.PlatformStand = false end
        end
    end
    LocalPlayer.CharacterAdded:Connect(function()
        orig = {}
        flyCleanup(false)
    end)

    RunService.Heartbeat:Connect(function()
        local h, root = getHum(), getRoot()
        if not h then return end
        if not (OPT.speed.on or OPT.jump.on or OPT.fly.on or orig.speed ~= nil or orig.jump ~= nil or bv or bg) then return end
        -- speed
        if OPT.speed.on then
            if orig.speed == nil then orig.speed = h.WalkSpeed end
            h.WalkSpeed = OPT.speed.v
        elseif orig.speed ~= nil then
            h.WalkSpeed = orig.speed
            orig.speed = nil
        end
        -- jump
        if OPT.jump.on then
            if orig.jump == nil then orig.jump = { h.UseJumpPower, h.JumpPower, h.JumpHeight } end
            h.UseJumpPower = true
            h.JumpPower = OPT.jump.v
        elseif orig.jump ~= nil then
            h.UseJumpPower, h.JumpPower, h.JumpHeight = orig.jump[1], orig.jump[2], orig.jump[3]
            orig.jump = nil
        end
        -- fly
        if OPT.fly.on and root then
            if not (bv and bv.Parent == root) then
                flyCleanup(false)
                bv = Instance.new("BodyVelocity")
                bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                bv.Velocity = Vector3.zero
                bv.Parent = root
                bg = Instance.new("BodyGyro")
                bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                bg.P = 9e4
                bg.D = 1e3
                bg.CFrame = root.CFrame
                bg.Parent = root
            end
            h.PlatformStand = true
            local cf = workspace.CurrentCamera.CFrame
            local md = h.MoveDirection
            local vel = Vector3.zero
            if md.Magnitude > 0.05 then
                local fl = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
                local fr = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
                local f = fl.Magnitude > 0.01 and md:Dot(fl.Unit) or 0
                local r = fr.Magnitude > 0.01 and md:Dot(fr.Unit) or 0
                vel = cf.LookVector * f + cf.RightVector * r
            end
            if not UserInputService:GetFocusedTextBox() then
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) or UserInputService:IsKeyDown(Enum.KeyCode.E) then
                    vel += Vector3.yAxis
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then
                    vel -= Vector3.yAxis
                end
            end
            bv.Velocity = vel.Magnitude > 0.01 and vel.Unit * OPT.fly.v or Vector3.zero
            local flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
            if flat.Magnitude > 0.01 then
                bg.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
            end
        elseif bv or bg then
            flyCleanup(true)
        end
    end)

    local function gotoPlayer(plr)
        pcall(function()
            local target = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            local mine = getRoot()
            if target and mine then
                mine.CFrame = target.CFrame * CFrame.new(0, 0, 3)
                mine.AssemblyLinearVelocity = Vector3.zero
            end
        end)
    end

    -- ===== UI: a row of capsules in the top-right corner of the sheet (no dropdown) =====
    local WHITE = Color3.new(1, 1, 1)
    local ON_COL = Color3.fromRGB(242, 242, 244)
    local DARK = Color3.fromRGB(18, 18, 20)
    local function buildBar()
        local function mk(class, props, parent)
            local o = Instance.new(class)
            for k, v in pairs(props) do o[k] = v end
            o.Parent = parent
            return o
        end
        local function round(o, r) mk("UICorner", { CornerRadius = r or UDim.new(1, 0) }, o) end
        local function text(o, bold) styleText(o, bold) end

        local Bar = mk("Frame", {
            Name = "SaikiTopTools", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 18),
            Size = UDim2.fromOffset(0, 34), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 60 }, HOST.Sheet)
        local barList = mk("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
            SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, Bar)
        local barScale = mk("UIScale", {}, Bar)
        -- One fixed, compact size that only depends on the screen width. It is NOT measured from the
        -- layout (measuring a scaled layout feeds back into itself and made the bar flash big/small).
        local NAT_W = 740 -- approximate unscaled width of the whole row
        local function fit()
            local gw = HOST.Gui.AbsoluteSize.X
            if gw <= 0 then
                local cam = workspace.CurrentCamera
                gw = cam and cam.ViewportSize.X or 1280
            end
            local avail = gw / 2 - 71 - 20 - 14 -- the space right of the centred Saiki button
            local target = math.floor(math.clamp(avail / NAT_W, 0.5, 0.9) * 100 + 0.5) / 100
            if barScale.Scale ~= target then barScale.Scale = target end
        end
        fit()
        HOST.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)

        local function capsule(order)
            local f = mk("Frame", {
                LayoutOrder = order, Size = UDim2.fromOffset(0, 34), AutomaticSize = Enum.AutomaticSize.X,
                BackgroundColor3 = SAIKIUI.ink, BackgroundTransparency = 0.06, BorderSizePixel = 0, ZIndex = 60 }, Bar)
            round(f)
            mk("UIStroke", { Color = WHITE, Transparency = 0.86, Thickness = 1 }, f)
            mk("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 6) }, f)
            mk("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
                SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }, f)
            return f
        end
        local function button(parent, order, txt, w, size)
            local b = mk("TextButton", {
                LayoutOrder = order, Size = UDim2.fromOffset(w, 26), BackgroundColor3 = WHITE, BackgroundTransparency = 1,
                BorderSizePixel = 0, AutoButtonColor = false, Text = txt, TextSize = size or 12,
                TextColor3 = SAIKIUI.mut, ZIndex = 61 }, parent)
            text(b, true)
            round(b)
            return b
        end
        local function setOn(b, on, instant)
            local goal = { BackgroundTransparency = on and 0 or 1, TextColor3 = on and DARK or SAIKIUI.mut }
            if instant then
                for k, v in pairs(goal) do b[k] = v end
            else
                TweenService:Create(b, TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), goal):Play()
            end
            b.BackgroundColor3 = HOST.Th.accA
        end
        -- hold a stepper to keep stepping
        local function repeater(btn, fn)
            local held = 0
            btn.InputBegan:Connect(function(i)
                if i.UserInputType ~= Enum.UserInputType.MouseButton1 and i.UserInputType ~= Enum.UserInputType.Touch then return end
                held += 1
                local mine = held
                fn()
                task.delay(0.35, function()
                    while held == mine and btn.Parent do
                        fn()
                        task.wait(0.06)
                    end
                end)
            end)
            btn.InputEnded:Connect(function() held += 1 end)
            btn.MouseLeave:Connect(function() held += 1 end)
        end

        -- Speed / Jump / Fly:  [ Name  -  value  + ]  (click the name to switch it on / off)
        local function stat(order, name, key)
            local o = OPT[key]
            local cap = capsule(order)
            local nameBtn = button(cap, 1, name, 0, 12)
            nameBtn.Size = UDim2.new(0, 0, 0, 26)
            nameBtn.AutomaticSize = Enum.AutomaticSize.X
            mk("UIPadding", { PaddingLeft = UDim.new(0, 11), PaddingRight = UDim.new(0, 11) }, nameBtn)
            setOn(nameBtn, o.on, true)
            local minus = button(cap, 2, "-", 22, 15)
            -- click the number and type your own value
            local val = mk("TextBox", {
                LayoutOrder = 3, Size = UDim2.fromOffset(38, 22), BackgroundColor3 = WHITE, BackgroundTransparency = 0.94,
                BorderSizePixel = 0, Text = tostring(o.v), TextSize = 12, TextColor3 = SAIKIUI.text, ClearTextOnFocus = true,
                PlaceholderText = "", ZIndex = 61 }, cap)
            text(val, true)
            round(val, UDim.new(0, 8))
            val.FocusLost:Connect(function()
                local n = tonumber(val.Text)
                if n then o.v = math.clamp(math.floor(n + 0.5), o.min, o.max) end
                val.Text = tostring(o.v)
            end)
            local plus = button(cap, 4, "+", 22, 15)
            for _, b in ipairs({ minus, plus }) do
                b.TextColor3 = SAIKIUI.text
                b.BackgroundTransparency = 0.92
            end
            local function change(d)
                o.v = math.clamp(o.v + d * o.step, o.min, o.max)
                val.Text = tostring(o.v)
            end
            repeater(minus, function() change(-1) end)
            repeater(plus, function() change(1) end)
            nameBtn.Activated:Connect(function()
                o.on = not o.on
                setOn(nameBtn, o.on)
            end)
        end
        stat(1, "Speed", "speed")
        stat(2, "Jump", "jump")
        stat(3, "Fly", "fly")

        -- Go to player:  [ <  name  >  Go ]
        do
            local cap = capsule(4)
            local prev = button(cap, 1, "<", 22, 14)
            local nameLbl = mk("TextLabel", {
                LayoutOrder = 2, Size = UDim2.fromOffset(104, 26), BackgroundTransparency = 1, Text = "No players",
                TextSize = 12, TextColor3 = SAIKIUI.text, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 61 }, cap)
            text(nameLbl, true)
            local nxt = button(cap, 3, ">", 22, 14)
            local go = button(cap, 4, "Go", 0, 12)
            go.Size = UDim2.new(0, 0, 0, 26)
            go.AutomaticSize = Enum.AutomaticSize.X
            mk("UIPadding", { PaddingLeft = UDim.new(0, 11), PaddingRight = UDim.new(0, 11) }, go)
            setOn(go, true, true)
            local viewBtn = button(cap, 5, "View", 0, 12)
            viewBtn.Size = UDim2.new(0, 0, 0, 26)
            viewBtn.AutomaticSize = Enum.AutomaticSize.X
            mk("UIPadding", { PaddingLeft = UDim.new(0, 11), PaddingRight = UDim.new(0, 11) }, viewBtn)
            setOn(viewBtn, false, true)
            for _, b in ipairs({ prev, nxt }) do
                b.TextColor3 = SAIKIUI.text
                b.BackgroundTransparency = 0.92
            end

            local others, sel = {}, nil
            local function refresh()
                local keep = others[sel or 0]
                table.clear(others)
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then others[#others + 1] = p end
                end
                table.sort(others, function(a, b) return a.DisplayName:lower() < b.DisplayName:lower() end)
                sel = nil
                for i, p in ipairs(others) do
                    if p == keep then sel = i end
                end
                if not sel and #others > 0 then sel = 1 end
                nameLbl.Text = sel and others[sel].DisplayName or "No players"
            end
            -- View: the camera follows the selected player (press again to go back to yourself)
            local viewing = nil
            local function stopView()
                viewing = nil
                setOn(viewBtn, false)
                local h, cam = getHum(), workspace.CurrentCamera
                if h and cam then cam.CameraSubject = h end
            end
            local function startView(p)
                local ch = p.Character
                local h = ch and ch:FindFirstChildOfClass("Humanoid")
                local cam = workspace.CurrentCamera
                if not (h and cam) then return false end
                cam.CameraSubject = h
                viewing = p
                setOn(viewBtn, true)
                return true
            end
            RunService.Heartbeat:Connect(function()
                if not viewing then return end
                if not viewing.Parent then
                    stopView()
                    return
                end
                local h = viewing.Character and viewing.Character:FindFirstChildOfClass("Humanoid")
                local cam = workspace.CurrentCamera
                if h and cam and cam.CameraSubject ~= h then cam.CameraSubject = h end
            end)
            viewBtn.Activated:Connect(function()
                if viewing then
                    stopView()
                elseif sel and others[sel] then
                    startView(others[sel])
                end
            end)
            local function step(d)
                if #others == 0 then return end
                sel = ((sel or 1) - 1 + d) % #others + 1
                nameLbl.Text = others[sel].DisplayName
                if viewing then startView(others[sel]) end
            end
            prev.Activated:Connect(function() step(-1) end)
            nxt.Activated:Connect(function() step(1) end)
            go.Activated:Connect(function()
                if sel and others[sel] then gotoPlayer(others[sel]) end
            end)
            Players.PlayerAdded:Connect(function() task.defer(refresh) end)
            Players.PlayerRemoving:Connect(function() task.defer(refresh) end)
            refresh()
        end
        fit()
        HOST.TopTools = Bar
    end
    local okBar, errBar = xpcall(buildBar, function(e) return tostring(e) .. "\n" .. tostring(debug.traceback()) end)
    if not okBar then task.defer(function() HOST.Report("Options", errBar) end) end
end

local visible = true
local hiddenByToggle = {}
function HOST.SetVisible(v)
    visible = v
    if v then FX.popIn() Env.apply() else FX.popOut() Env.restore() end
    if not v then
        table.clear(hiddenByToggle)
        for _, child in ipairs(HOST.Gui:GetChildren()) do
            if child ~= Toggle and child ~= HOST.Sheet and child ~= HOST.Dim and child:IsA("GuiObject") and child.Visible then
                hiddenByToggle[child] = true
                child.Visible = false
            end
        end
    else
        for child in pairs(hiddenByToggle) do
            if child.Parent then child.Visible = true end
        end
        table.clear(hiddenByToggle)
    end
end
Toggle.Activated:Connect(function()
    HOST.SetVisible(not visible)
end)

function HOST.Report(name, err)
    local msg = "[SAIKI] " .. tostring(name) .. " failed to load:\n" .. tostring(err)
    pcall(function() warn(msg) end)
    pcall(function()
        local box = Instance.new("TextButton")
        box.Name = "SaikiError_" .. tostring(name)
        box.AutoButtonColor = false
        box.BackgroundColor3 = Color3.fromRGB(40, 10, 14)
        box.BackgroundTransparency = 0.1
        box.BorderSizePixel = 0
        box.Position = UDim2.fromOffset(34, 84 + (HOST.ErrCount or 0) * 130)
        box.Size = UDim2.fromOffset(460, 122)
        box.Text = string.sub(msg, 1, 420)
        box.TextSize = 11
        box.Font = Enum.Font.Code
        box.TextColor3 = Color3.fromRGB(255, 200, 205)
        box.TextWrapped = true
        box.TextXAlignment = Enum.TextXAlignment.Left
        box.TextYAlignment = Enum.TextYAlignment.Top
        box.ZIndex = 900
        box.Parent = HOST.Gui
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 12)
        local pad = Instance.new("UIPadding", box)
        pad.PaddingLeft = UDim.new(0, 10)
        pad.PaddingTop = UDim.new(0, 8)
        pad.PaddingRight = UDim.new(0, 10)
        box.Activated:Connect(function() box:Destroy() end)
        HOST.ErrCount = (HOST.ErrCount or 0) + 1
    end)
end

function HOST.Run(name, fn)
    local ok, err = xpcall(fn, function(e)
        return tostring(e) .. "\n" .. tostring(debug.traceback())
    end)
    if not ok then HOST.Report(name, err) end
end

function HOST.Start()
    HOST.Sheet.Visible = true
    HOST.Relayout()
    HOST.JumpSection(1, true)
    FX.popIn(true)
    Env.apply()
end


