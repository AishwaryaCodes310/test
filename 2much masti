-- Each project gets one session object. The anonymous login is SAVED to disk (refresh token), so the same
-- Firebase uid is reused every launch (no sign-up spam / rate limits, and follower data stays yours).
local auth, dmAuth, ensureToken -- filled in below

local function requestJSON(method, url, body, headers)
	if not REQUEST then return false, nil, "no request function" end
	local opts = { Url = url, Method = method, Headers = { ["Content-Type"] = "application/json" } }
	if headers then for k, v in pairs(headers) do opts.Headers[k] = v end end
	if body ~= nil then opts.Body = (type(body) == "string") and body or HttpService:JSONEncode(body) end
	local ok, res = pcall(REQUEST, opts)
	if not ok or not res then
		if T.guardFail then pcall(T.guardFail, res) end
		return false, nil, tostring(res)
	end
	local code = tonumber(res.StatusCode or res.Status or 0) or 0
	local raw = res.Body or res.body or ""
	local decoded
	if raw ~= "" then pcall(function() decoded = HttpService:JSONDecode(raw) end) end
	if T.guardNote then pcall(T.guardNote, code >= 200 and code < 300, code, url) end
	return code >= 200 and code < 300, decoded, raw, code
end

local function dbURL(base, path, token, extra)
	local url, q = base .. path .. ".json", {}
	if token and token ~= "" then q[#q + 1] = "auth=" .. enc(token) end
	if extra and extra ~= "" then q[#q + 1] = extra end
	if #q > 0 then url = url .. "?" .. table.concat(q, "&") end
	return url
end

do -- login helpers stay private to this block (keeps the script under Luau's 200-local limit)
local function newAuth(name, key)
	return { name = name, key = key, token = nil, refresh = nil, uid = nil, exp = 0, busy = false, loaded = false, err = nil }
end
auth = newAuth("knownschat", FIREBASE_API_KEY)
dmAuth = newAuth("knownsdm", DM_FIREBASE_API_KEY)

local function sessionPath(t) return CACHE .. "/session_" .. t.name .. "_" .. ME .. ".json" end
local function loadSession(t)
	if not (isfile and readfile) then return end
	pcall(function()
		if not isfile(sessionPath(t)) then return end
		local d = HttpService:JSONDecode(readfile(sessionPath(t)))
		if type(d) == "table" and type(d.refresh) == "string" and d.refresh ~= "" then
			t.refresh, t.uid = d.refresh, d.uid
		end
	end)
end
local function saveSession(t)
	if not writefile or not t.refresh then return end
	pcall(function()
		if makefolder and isfolder and not isfolder(CACHE) then makefolder(CACHE) end
		writefile(sessionPath(t), HttpService:JSONEncode({ refresh = t.refresh, uid = t.uid }))
	end)
end

local function errText(data, raw)
	if type(data) == "table" and type(data.error) == "table" and data.error.message then return tostring(data.error.message):sub(1, 120) end
	return tostring(raw or "no response"):sub(1, 120)
end
local function applyToken(t, idToken, refresh, uid, expires)
	t.token = idToken
	if refresh then t.refresh = refresh end
	if uid then t.uid = uid end
	t.exp = os.time() + (tonumber(expires) or 3600) - 180 -- renew 3 minutes BEFORE it expires
	t.err = nil
end
local function signUp(t)
	local ok, data, raw = requestJSON("POST", "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key=" .. t.key, { returnSecureToken = true })
	if ok and type(data) == "table" and data.idToken then
		applyToken(t, data.idToken, data.refreshToken, data.localId, data.expiresIn)
		saveSession(t)
		return true
	end
	t.err = errText(data, raw)
	return false
end
local function refreshTok(t)
	if not t.refresh then return false end
	local ok, data, raw, code = requestJSON("POST", "https://securetoken.googleapis.com/v1/token?key=" .. t.key,
		"grant_type=refresh_token&refresh_token=" .. enc(t.refresh), { ["Content-Type"] = "application/x-www-form-urlencoded" })
	if ok and type(data) == "table" and data.id_token then
		applyToken(t, data.id_token, data.refresh_token, data.user_id, data.expires_in)
		saveSession(t)
		return true
	end
	t.err = errText(data, raw)
	-- only a definite "this login is dead" answer discards the saved login; network hiccups keep it
	if code == 400 then t.refresh = nil end
	return false
end

-- Make sure t.token is valid. Single-flight: parallel callers wait for ONE login instead of each signing up.
-- force=true + badToken: the server rejected badToken, so renew (unless someone already did).
function ensureToken(t, force, badToken)
	if not force and t.token and os.time() < t.exp then return true end
	local waited = 0
	while t.busy and waited < 20 do task.wait(0.1); waited = waited + 0.1 end
	if force and t.token and t.token ~= badToken and os.time() < t.exp then return true end
	if not force and t.token and os.time() < t.exp then return true end
	t.busy = true
	if not t.loaded then t.loaded = true; loadSession(t) end
	local ok = false
	for attempt = 1, 4 do
		if t.refresh then
			if refreshTok(t) then ok = true; break end
		end
		if not t.refresh then
			if signUp(t) then ok = true; break end
		end
		task.wait(0.5 * attempt)
	end
	t.busy = false
	return ok
end

end -- login helpers

local function dbRequestRaw(method, path, body, target, base, extra)
	target, base = target or auth, base or FIREBASE_DB
	if not ensureToken(target) then return false, nil, "auth failed: " .. tostring(target.err), nil end
	local used, refreshed, tries = target.token, false, 0
	local ok, data, raw, code
	while true do
		tries = tries + 1
		ok, data, raw, code = requestJSON(method, dbURL(base, path, used, extra), body)
		if ok then break end
		if code == 401 and not refreshed then
			refreshed = true -- token may have just expired: renew once and retry
			if not ensureToken(target, true, used) then break end
			used = target.token
		elseif tries < 3 and (code == nil or code == 0 or code == 429 or code >= 500) then
			task.wait(0.5 * tries) -- transient network / server hiccup
		else
			break
		end
	end
	return ok, data, raw, code
end

-- Chat identity: like the DM project, the chat project ties your Roblox id to your login, so nobody can post, react or
-- edit a profile as someone else (moderator announcements and music broadcasts rely on this).
local chatIdState = { ok = false, busy = false, retryAt = 0, warned = false }
function T.chatId()
	local st = chatIdState
	if st.ok or not REQUEST then return st.ok end
	if st.busy then
		local w = 0
		while st.busy and w < 15 do task.wait(0.1); w = w + 0.1 end
		return st.ok
	end
	if os.clock() < st.retryAt then return false end
	st.busy = true
	local good, why = false, nil
	if ensureToken(auth) and auth.uid then
		local uid = tostring(auth.uid)
		local ok1, _, _, c1 = dbRequestRaw("PUT", "/users/" .. ME, '"' .. uid .. '"', auth, FIREBASE_DB)
		if ok1 then
			local ok2, _, _, c2 = dbRequestRaw("PUT", "/uidmap/" .. uid, '"' .. ME .. '"', auth, FIREBASE_DB)
			good = ok2 and true or false
			if not ok2 then why = "uidmap HTTP " .. tostring(c2) end
		else
			why = "users HTTP " .. tostring(c1)
		end
	else
		why = "chat login not ready"
	end
	st.ok, st.busy = good, false
	if not good then
		st.retryAt = os.clock() + 30
		if not st.warned then
			st.warned = true
			warn("[SAIKI RECHAT] Chat identity not registered (" .. tostring(why) .. "). Publish the knownshangoutchat rules; if this Roblox id was linked to another login, delete /users/" .. ME .. " in the knownshangoutchat database.")
		end
	end
	return good
end

local function dbRequest(method, path, body, target, base, extra)
	if method ~= "GET" and (target or auth) == auth then T.chatId() end
	return dbRequestRaw(method, path, body, target, base, extra)
end

