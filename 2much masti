function HOST.Relayout()
    local gs = HOST.Gui.AbsoluteSize
    if gs.X <= 0 or gs.Y <= 0 then
        local cam = workspace.CurrentCamera
        gs = cam and cam.ViewportSize or Vector2.new(1280, 720)
    end
    local compact = gs.Y < 560
    local topH = compact and 54 or 80
    local dockH = compact and 34 or 42
    -- the bottom dock lives in this strip, so cards run almost to the bottom edge instead of leaving a blank band
    local botH = dockH + (compact and 14 or 22)
    pageTitle.Position = UDim2.fromOffset(34, compact and 8 or 26)
    pageTitle.TextSize = compact and 20 or 24
    pageSub.Position = UDim2.fromOffset(35, compact and 34 or 56)
    Scroll.Position = UDim2.fromOffset(0, topH)
    Scroll.Size = UDim2.new(1, 0, 1, -(topH + botH))
    if HOST.LayoutDock then pcall(HOST.LayoutDock, compact, dockH) end

    local A = math.max(160, gs.Y - topH - botH - 8)
    local s = math.clamp(A / DESIGN_H, 0.5, 2)
    local x = PAD_X
    table.clear(HOST.SecStart)
    for _, col in ipairs(HOST.Cols) do
        if #col.cards > 0 then
            if not HOST.SecStart[col.section] then HOST.SecStart[col.section] = x end
            local cw = col.w * s
            local fixedSum, flexN = 0, 0
            for _, c in ipairs(col.cards) do
                if type(c.h) == "number" then fixedSum += c.h * s else flexN += 1 end
            end
            local gaps = (#col.cards - 1) * GAP_Y * s
            local flexH = flexN > 0 and math.max(70 * s, (A - fixedSum - gaps) / flexN) or 0
            -- a column made only of fixed cards stretches them so it still fills the height (no gap under it)
            local boost = 1
            if flexN == 0 and fixedSum > 0 and fixedSum + gaps < A then
                boost = math.min(1.6, (A - gaps) / fixedSum)
            end
            local total = fixedSum * boost + gaps + flexH * flexN
            local y = 3
            if col.valign ~= "top" then y = 3 + math.max(0, (A - total) / 2) end
            for _, c in ipairs(col.cards) do
                local h = (type(c.h) == "number") and (c.h * s * boost) or flexH
                c.frame.Position = UDim2.fromOffset(x, y)
                c.frame.Size = UDim2.fromOffset(cw, h)
                c.stage.Size = UDim2.fromOffset(cw / s, h / s)
                c.scale.Scale = s
                if c.corner then
                    local pill = type(c.h) == "number" and c.h <= 64
                    local rad = pill and UDim.new(0, math.floor(h / 2)) or UDim.new(0, math.floor((c.r or 18) * s + 0.5))
                    c.corner.CornerRadius = rad
                    if c.shineCorner then c.shineCorner.CornerRadius = rad end
                    if c.fillCorner then c.fillCorner.CornerRadius = rad end
                    if c.shine then c.shine.Size = UDim2.new(1, 0, 0, pill and math.floor(h) or math.floor(46 * s)) end
                end
                y += h + GAP_Y * s
            end
            x += cw + GAP_X
        end
    end
    Scroll.CanvasSize = UDim2.fromOffset(math.max(0, x - GAP_X + PAD_X), 0)
    local maxX = math.max(0, Scroll.CanvasSize.X.Offset - Scroll.AbsoluteSize.X)
    if Scroll.CanvasPosition.X > maxX then Scroll.CanvasPosition = Vector2.new(maxX, 0) end
    updateSection()
end

local layoutQueued = false
local function queueRelayout()
    if layoutQueued then return end
    layoutQueued = true
    task.defer(function()
        layoutQueued = false
        HOST.Relayout()
    end)
end
