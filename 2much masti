					order += 1
					makeRow(song, order, songs, i)
				end
				if keepScroll == true then
					task.defer(function() list.CanvasPosition = Vector2.new(0, y) end)
				end
			end

			onDatabase = function() buildChips() refreshLibrary() end
			ui.onYT = function() if view == "YouTube" then refreshLibrary() end end

