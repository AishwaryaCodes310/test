	------------------------------------------------------------ the trolls
	local function follow(name, sitting, animId, offset)
		local p = needTarget()
		if not p then return end
		local hum = myHum()
		if not hum then say("No character.") return end
		stopFollow(name)
		local track
		if animId then
			pcall(function()
				local an = new("Animation", { AnimationId = "rbxassetid://" .. animId })
				track = hum:LoadAnimation(an)
				track:Play(0.1, 1, 1)
			end)
		end
		if sitting then hum.Sit = true end
		local a = begin(name, function()
			if track then pcall(function() track:Stop() end) end
			local h = myHum()
			if h and sitting then h.Sit = false end
		end)
		a.conns[#a.conns + 1] = RunService.Heartbeat:Connect(function()
			local mr, tr, h = root(LP.Character), root(p.Character), myHum()
			if not (p.Parent and mr and tr and h) or (sitting and not h.Sit) then stop(name) return end
			mr.CFrame = tr.CFrame * offset
			mr.AssemblyLinearVelocity = Vector3.zero
			mr.AssemblyAngularVelocity = Vector3.zero
		end)
		a.conns[#a.conns + 1] = UIS.JumpRequest:Connect(function() stop(name) end)
		say("On " .. p.DisplayName .. " - jump to stop.")
	end

	local function stare(name, pick)
		local hum = myHum()
		if not hum then say("No character.") return end
		if name == "stare" and not needTarget() then return end
		hum.AutoRotate = false
		local a = begin(name, function()
			local h = myHum()
			if h then h.AutoRotate = true end
		end)
		a.conns[#a.conns + 1] = RunService.RenderStepped:Connect(function()
			local mr = root(LP.Character)
			local t = pick()
			local tr = t and root(t.Character)
			if not (mr and tr) then return end
			local pos = mr.Position
			local flat = Vector3.new(tr.Position.X, pos.Y, tr.Position.Z)
			if (flat - pos).Magnitude > 0.1 then mr.CFrame = CFrame.new(pos, flat) end
		end)
	end

	local function closest()
		local mr = root(LP.Character)
		if not mr then return nil end
		local best, bd = nil, math.huge
		for _, pl in ipairs(Players:GetPlayers()) do
			local r = pl ~= LP and root(pl.Character)
			if r then
				local d = (r.Position - mr.Position).Magnitude
				if d < bd then bd, best = d, pl end
			end
		end
		return best
	end

