		if not cmd then return false end
		cmd = cmd:lower()
		if not isCmd(cmd) then return false end
		if not ready then view.notice("The moderator list is still loading, try again in a moment."); return true end
		local musicCmd = (cmd == "!musicallow" or cmd == "!musicremove")
		if not (T.isMod(ME) or (musicCmd and T.isMusicAdmin and T.isMusicAdmin(ME))) then view.notice("Moderator commands are for Saiki Rechat moderators only."); return true end
		local args = txt:match("^%S+%s+(.*)$") or ""
		task.spawn(function()
			local ok, err = pcall(runCmd, view, cmd, args)
			if not ok then view.notice("Command failed: " .. tostring(err)) end
		end)
		return true
	end

	-- auto-fill chips for the chat box (moderators only)
	function T.modSuggest(text)
		if not (ready and T.isMod(ME)) or text:sub(1, 1) ~= "!" then return nil end
		local out = {}
		local word = text:match("^(!%S*)$")
		if word then
			local low = word:lower()
			for _, c in ipairs(CMDS) do
				if c:sub(1, #low) == low and c ~= low then out[#out + 1] = { label = c, fill = c .. " " } end
			end
			return out
		end
		local cmd, args = text:match("^(!%S+)%s(.*)$")
		if not cmd then return nil end
		cmd = cmd:lower()
		if not isCmd(cmd) or cmd == "!saikianc" then return nil end
		local first, tail = args:match("^(%S*)(.*)$")
		if tail == "" then -- still typing the username
			local low = first:lower()
			low = low:gsub("^@", "")
			for _, p in ipairs(Players:GetPlayers()) do
				local nm, dn = p.Name:lower(), p.DisplayName:lower()
				local hit = low == "" or nm:sub(1, #low) == low or dn:sub(1, #low) == low
					or (#low >= 2 and (nm:find(low, 1, true) ~= nil or dn:find(low, 1, true) ~= nil))
				local protected = (cmd == "!saikikick" or cmd == "!saikimute") and T.isMod(p.UserId)
				if hit and not protected then
					out[#out + 1] = { label = (p.DisplayName ~= p.Name) and (p.DisplayName .. " (@" .. p.Name .. ")") or p.Name, fill = cmd .. " " .. p.Name .. " " }
					if #out >= 6 then break end
				end
			end
			return out
		end
		local second = tail:match("^%s+(%S*)$") -- nil once a second word is finished
		if second == nil then return nil end
		local low = second:lower()
		if cmd == "!giveframe" then
			local cands = secretKeys()
			cands[#cands + 1] = "off"
			for _, k in ipairs(cands) do
				if low == "" or k:lower():sub(1, #low) == low then out[#out + 1] = { label = k, fill = cmd .. " " .. first .. " " .. k } end
				if #out >= 8 then break end
			end
		elseif cmd == "!saikimute" then
			for _, k in ipairs({ "off", "10", "30", "60", "1440" }) do
				if low == "" or k:sub(1, #low) == low then
					out[#out + 1] = { label = (k == "off") and "off (unmute)" or (k .. " min"), fill = cmd .. " " .. first .. " " .. k }
				end
			end
		elseif cmd == "!saikicustomtitle" then
			if low == "" or ("off"):sub(1, #low) == low then out[#out + 1] = { label = "off (remove tag)", fill = cmd .. " " .. first .. " off" } end
		end
		return out
	end

	task.spawn(function()
		pcall(loadMods)
		while alive do
			pcall(pollMods)
			task.wait(20)
		end
	end)
	task.spawn(function()
		while alive do
			task.wait(600)
			pcall(loadMods)
		end
	end)
end)()

