				local untilMs = mins and (nowMs() + mins * 60000) or 0
				ok, _, _, code = put("/mods/mute/" .. id .. "/" .. me, { ts = SV, ["until"] = untilMs })
				view.notice(ok and (shown .. " is muted " .. (mins and ("for " .. mins .. " min") or "until you unmute them (!saikimute " .. shown .. " off)") .. ".")
					or ("Couldn't mute (HTTP " .. tostring(code) .. ")."))
			end
		elseif cmd == "!saikicustomtitle" then
			if rest == "" then view.notice("Usage: !saikicustomtitle <username> <tag text | off>"); return end
			if rest:lower() == "off" then
				ok, _, _, code = del("/mods/title/" .. id .. "/" .. me)
				view.notice(ok and ("Custom tag removed from " .. shown .. ".") or ("Couldn't remove it (HTTP " .. tostring(code) .. ")."))
