	-- permissions given by moderators: /mods/music/<userId>/<moderatorId>
	function T.pollMusic()
		if not REQUEST then return end
		T.dmId()
		local ok, data = dbRequest("GET", "/mods/music", nil, dmAuth, DM_FIREBASE_DB)
