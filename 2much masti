	local function nudge(col) return Color3.new(math.min(1, col.R + 0.002), col.G, col.B) end
	local function paintChips()
		for name, ch in pairs(chips) do
			local sel = (name == V.theme)
			tween(ch.btn, 0.2, { BackgroundTransparency = sel and 0.8 or 0.94 })
			tween(ch.str, 0.2, { Transparency = sel and 0.35 or 0.92 })
		end
		tagLbl.Text = (THEMES[V.theme] and THEMES[V.theme].tag) or ""
	end
	-- Theme engine (stateless): every colour is looked up by what it IS right now, so it never depends on which theme was
	-- active before. A colour that belongs to any theme's palette (bg / cardA / accA / accB / text / mut) simply becomes the
	-- same slot of the new theme; white (or a theme's overlay colour) on see-through surfaces becomes the new overlay colour.
	-- The window frame, cards, dock and top capsule are restyled by HOST.SetTheme.
	local function ckey(c) return math.floor(c.R * 255 + 0.5) * 65536 + math.floor(c.G * 255 + 0.5) * 256 + math.floor(c.B * 255 + 0.5) end
	local WHITEK = 16777215
	local ROLE, OVSET = {}, {}
	local ROLES = { "bg", "cardA", "accA", "accB", "text", "mut", "field", "btn" }
	local function register(th)
		for _, r in ipairs(ROLES) do
			local k = ckey(th[r])
			if ROLE[k] == nil then ROLE[k] = r end
		end
		if ckey(th.ov) ~= WHITEK then OVSET[ckey(th.ov)] = true end
	end
	for _, th in pairs(THEMES) do register(th) end
	ROLE[ckey(Color3.fromRGB(150, 150, 156))] = ROLE[ckey(Color3.fromRGB(150, 150, 156))] or "mut" -- the muted grey other tabs use
	local BG_ROLES = { bg = true, cardA = true, accA = true, accB = true, field = true, btn = true }
	local TX_ROLES = { text = true, mut = true, accA = true, accB = true }
	local function hasGrad(o) return o:FindFirstChildOfClass("UIGradient") ~= nil end
	local function bgRole(o)
		local k = ckey(o.BackgroundColor3)
		if k == WHITEK then
			if o.BackgroundTransparency >= 0.5 and not hasGrad(o) then return "ov" end
			return nil
		end
		if OVSET[k] then return "ov" end
		local r = ROLE[k]
		if r and BG_ROLES[r] then return r end
		return nil
	end
	-- objects the recolor must not touch: HOST.SetTheme owns the host pieces, and "NoTheme" marks swatches / sky pictures
	local function frozen(o)
		if o:GetAttribute("HostTheme") then return true end
		local par = o.Parent
		if par and par:GetAttribute("HostTheme") then return true end
		local p = o
		while p and p ~= gui do
			if p:GetAttribute("NoTheme") then return true end
			p = p.Parent
		end
		return false
	end
	local function inButton(o)
		local btn = gui:FindFirstChild("SaikiButton") -- the open/close button keeps its own look in every theme
		return btn ~= nil and (o == btn or o:IsDescendantOf(btn))
	end
	local function recolor(th, instant)
		local entries = {}
		local function add(o, prop, role, allowed)
			local c = o[prop]
			local k = ckey(c)
			local r = role
			if not r then
				r = ROLE[k]
				if not (r and allowed[r]) then return end
			end
			local to = th[r]
			if to and ckey(to) ~= k then entries[#entries + 1] = { o = o, p = prop, from = c, to = to } end
		end
		local list = gui:GetDescendants()
		for i, o in ipairs(list) do
			if not inButton(o) and not frozen(o) then
				if o:IsA("GuiObject") then
					add(o, "BackgroundColor3", bgRole(o), BG_ROLES)
					if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
						add(o, "TextColor3", nil, TX_ROLES)
					elseif o:IsA("ScrollingFrame") then
						add(o, "ScrollBarImageColor3", nil, TX_ROLES)
					end
				elseif o:IsA("UIStroke") then
					local k = ckey(o.Color)
					if (k == WHITEK or OVSET[k]) and ckey(th.ov) ~= k then entries[#entries + 1] = { o = o, p = "Color", from = o.Color, to = th.ov } end
				elseif o:IsA("UIGradient") then
					local kps, to, changed = o.Color.Keypoints, {}, false
					for n, kp in ipairs(kps) do
						local r = ROLE[ckey(kp.Value)]
						if r and BG_ROLES[r] and ckey(th[r]) ~= ckey(kp.Value) then to[n] = th[r]; changed = true else to[n] = kp.Value end
					end
					if changed then entries[#entries + 1] = { o = o, seq = true, kps = kps, to = to } end
				end
			end
			if i % 300 == 0 then task.wait() end
		end
		local function frame(e)
			for _, en in ipairs(entries) do
				if en.o.Parent then
					if en.seq then
						local out = {}
						for n, kp in ipairs(en.kps) do out[n] = ColorSequenceKeypoint.new(kp.Time, kp.Value:Lerp(en.to[n], e)) end
						en.o.Color = ColorSequence.new(out)
					else
						en.o[en.p] = en.from:Lerp(en.to, e)
					end
				end
			end
		end
		if instant then
			win.BackgroundTransparency = th.bgT
			frame(1)
			return
		end
		tween(win, 0.5, { BackgroundTransparency = th.bgT })
		local t0 = os.clock()
		while true do
			local f = math.clamp((os.clock() - t0) / 0.5, 0, 1)
			frame(f * f * (3 - 2 * f)) -- smooth ease in/out
			if f >= 1 then break end
			RunService.Heartbeat:Wait()
		end
		frame(1)
	end
	function setTheme(name, instant)
		local th = THEMES[name]
		if busy or not th then return end
		busy = true
		T.bg, T.accA, T.accB, T.text, T.mut, T.ov, T.bgT = th.bg, th.accA, th.accB, th.text, th.mut, th.ov, th.bgT
		pcall(function()
			SAIKIUI.text, SAIKIUI.mut, SAIKIUI.ink = th.text, th.mut, th.cardA -- things built later start in the new colours
			HOST.AccentA = th.accA -- the animated title gradient follows the theme
		end)
		pcall(function() if HOST.SetTheme then HOST.SetTheme(th, instant) end end) -- cards, dock, top capsule, background
		task.spawn(function()
			local ok, err = pcall(recolor, th, instant)
			if not ok then warn("[SAIKI RECHAT] theme change: " .. tostring(err)) end
			busy = false
		end)
	end
	-- things created later (new chat messages, popups, tabs built after a theme change) are put in the current theme straight away
	local function applyNew(o, th)
		if not th or not o.Parent or inButton(o) or frozen(o) then return end
		if o:IsA("GuiObject") then
			local r = bgRole(o)
			if r and th[r] and ckey(th[r]) ~= ckey(o.BackgroundColor3) then o.BackgroundColor3 = th[r] end
			if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
				local tr = ROLE[ckey(o.TextColor3)]
				if tr and TX_ROLES[tr] and ckey(th[tr]) ~= ckey(o.TextColor3) then o.TextColor3 = th[tr] end
			end
		elseif o:IsA("UIStroke") then
			local k = ckey(o.Color)
			if (k == WHITEK or OVSET[k]) and ckey(th.ov) ~= k then o.Color = th.ov end
		end
	end
	H.bind(gui.DescendantAdded, function(o)
		if V.theme == "Modern" then return end
		task.defer(function() pcall(applyNew, o, THEMES[V.theme]) end)
	end)
	for i, name in ipairs(ORDER) do
		local th = THEMES[name]
		local sel = (name == V.theme)
		local btn = new("TextButton", { Position = UDim2.new(((i - 1) % 4) / 4, 0, 0, math.floor((i - 1) / 4) * 42), Size = UDim2.new(1 / 4, -5, 0, 36),
			BackgroundColor3 = WHITE, BackgroundTransparency = sel and 0.8 or 0.94, Text = "", AutoButtonColor = false, Parent = row },
			{ corner(12) })
		local str = stroke(sel and 0.35 or 0.92)
		str.Parent = btn
		local sw = new("UIGradient", { Color = ColorSequence.new(nudge(th.accA), nudge(th.accB)), Rotation = 0 })
		local swatch = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 5), Size = UDim2.fromOffset(26, 8),
			BackgroundColor3 = WHITE, Parent = btn }, { corner(4), sw })
		swatch:SetAttribute("NoTheme", true) -- a theme's preview colours must never be recoloured
		new("TextLabel", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.new(1, -8, 0, 14),
			BackgroundTransparency = 1, Text = name, Font = T.fontB, TextSize = 11, TextScaled = true, TextColor3 = T.text, Parent = btn },
			{ new("UITextSizeConstraint", { MaxTextSize = 11, MinTextSize = 7 }) })
		chips[name] = { btn = btn, str = str, sw = sw }
		btn.Activated:Connect(function()
			if busy or name == V.theme then return end
			V.theme = name
			paintChips()
			save()
			setTheme(name)
		end)
	end
	local function applyCustom()
		local col = parseHex(hexBox.Text)
		if not col then
			hexBox.Text = V.custom -- not a colour: put the last good one back
			return
		end
		if busy then return end
		V.custom = hexOf(col)
		hexBox.Text = V.custom
		THEMES.Custom = buildCustom(col)
		register(THEMES.Custom)
		chips.Custom.sw.Color = ColorSequence.new(nudge(THEMES.Custom.accA), nudge(THEMES.Custom.accB))
		V.theme = "Custom"
		paintChips()
		save()
		setTheme("Custom")
	end
	applyBtn.Activated:Connect(applyCustom)
	hexBox.FocusLost:Connect(function(enter) if enter then applyCustom() end end)
	paintChips()
end

