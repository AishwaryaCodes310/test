		if self.split then self.split(false) else list.Size = UDim2.new(1, 0, 1, -58) end
	end
	function self.setReply(item)
		local prev = item.stk and "Sticker" or clean(item.text or "")
		self.replyTo = { k = tostring(item.key), n = cut(item.name, 40), t = cut(prev, 60) }
		replyTxt.Text = "Replying to " .. self.replyTo.n .. ": " .. cut(prev, 40)
		replyBar.Visible = true
		if self.split then self.split(true) else list.Size = UDim2.new(1, 0, 1, -96) end
		pcall(function() box:CaptureFocus() end)
	end
	replyX.Activated:Connect(function() self.clearReply() end)

	local nextOk = 0
	local function fire(p)
		if T.isMuted and T.isMuted(ME) then self.notice("You are muted by a moderator."); return false end
		if os.clock() < nextOk then return false end
		if cooldown and cooldown > 0 then
			nextOk = os.clock() + cooldown
			task.spawn(function()
				while alive and os.clock() < nextOk do
					btn.Text = tostring(math.ceil(nextOk - os.clock())) .. "s"
					task.wait(0.25)
				end
				btn.Text = "Send"
			end)
		end
		if self.replyTo then p.reply = self.replyTo; self.clearReply() end
		onSend(p)
		return true
	end
	local function submit()
		local txt = clean(box.Text)
		if txt == "" then return end
		if T.chatCommand and T.chatCommand(txt) then box.Text = ""; return end -- dev-only test command (never sent as a message)
		local low = txt:lower()
		if (low == "!anc" or low:sub(1, 5) == "!anc ") and T.annSend then -- announcement command (checked + sent by T.annSend)
			if T.annSend(self, txt) then box.Text = "" end
			return
		end
		if low:sub(1, 1) == "!" and T.modCmd and T.modCmd(self, txt) then box.Text = ""; return end -- moderator commands
		if fire({ text = txt }) then box.Text = "" end
	end
	bind(btn.Activated, submit)
	bind(box.FocusLost, function(enter) if enter then submit() end end)
	function self.sendSticker(ref) return fire({ stk = ref }) end
	function self.sendText(t) return fire({ text = t }) end

