	local function loopFling()
		local p = needTarget()
		if not p then return end
		local a = begin("loopfling", function()
			local r = root(LP.Character)
			if r then
				local bv = r:FindFirstChild("SaikiLoopFling")
				if bv then bv:Destroy() end
				r.AssemblyLinearVelocity = Vector3.zero r.AssemblyAngularVelocity = Vector3.zero
			end
		end)
		task.spawn(function()
			while active.loopfling == a do
				if not p.Parent then stop("loopfling") break end
				local mr, tr, h = root(LP.Character), root(p.Character), myHum()
				if mr and tr and h and h.Health > 0 then
					local home = mr.CFrame
					local bv = new("BodyVelocity", { Name = "SaikiLoopFling", Velocity = Vector3.new(math.random(-400, 400), math.random(200, 500), math.random(-400, 400)), MaxForce = Vector3.new(1 / 0, 1 / 0, 1 / 0) }, mr)
					local t0, ang = tick(), 0
					while active.loopfling == a and tick() - t0 < 2 and tr.Parent and mr.Parent do
						ang += 100
						mr.CFrame = CFrame.new(tr.Position) * CFrame.new(0, 1.5, 0) * CFrame.Angles(math.rad(ang), 0, 0)
						task.wait()
						mr.CFrame = CFrame.new(tr.Position) * CFrame.new(0, -1.5, 0) * CFrame.Angles(math.rad(ang), 0, 0)
						task.wait()
					end
					bv:Destroy()
					if mr.Parent then
						mr.AssemblyLinearVelocity = Vector3.zero mr.AssemblyAngularVelocity = Vector3.zero
						mr.CFrame = home
					end
				end
				task.wait(0.05)
			end
		end)
	end

	local function helicopter()
		local hum, mr = myHum(), root(LP.Character)
		if not (hum and mr) then say("No character.") return end
		local track, sound
		pcall(function()
			local an = new("Animation", { AnimationId = "rbxassetid://129132611803602" })
			local animator = hum:FindFirstChildOfClass("Animator") or new("Animator", {}, hum)
			track = animator:LoadAnimation(an)
			track.Priority = Enum.AnimationPriority.Action4
			track.Looped = true
			track:Play(0.1, 1, 1)
		end)
		sound = new("Sound", { Name = "SaikiHeli", SoundId = "rbxassetid://99103708154004", Volume = 0.35, Looped = true, RollOffMode = Enum.RollOffMode.InverseTapered }, mr)
		pcall(function() sound:Play() end)
		local bv = new("BodyVelocity", { MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero }, mr)
		local bg = new("BodyGyro", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 9e4, CFrame = mr.CFrame }, mr)
		hum.PlatformStand = true
		local a = begin("helicopter", function()
			pcall(function() bv:Destroy() end)
			pcall(function() bg:Destroy() end)
			pcall(function() sound:Stop() sound:Destroy() end)
			if track then pcall(function() track:Stop(0) end) end
			local h = myHum()
			if h then h.PlatformStand = false end
		end)
		a.conns[#a.conns + 1] = RunService.Heartbeat:Connect(function()
			local h, r = myHum(), root(LP.Character)
			if not (h and r and bv.Parent) then stop("helicopter") return end
			local cam = workspace.CurrentCamera
			local v = Vector3.zero
			local md = h.MoveDirection
			if md.Magnitude > 0 then
				local o = cam.CFrame:VectorToObjectSpace(md)
				v = cam.CFrame.LookVector * (-o.Z) + cam.CFrame.RightVector * o.X
			end
			local up = 0
			if UIS:IsKeyDown(Enum.KeyCode.E) then up += 1 end
			if UIS:IsKeyDown(Enum.KeyCode.Q) then up -= 1 end
			bv.Velocity = v * 60 + Vector3.new(0, up * 50, 0)
			local look = cam.CFrame.LookVector
			bg.CFrame = CFrame.lookAt(Vector3.zero, Vector3.new(look.X, 0, look.Z) + Vector3.new(0, 0, 1e-4))
		end)
		a.conns[#a.conns + 1] = hum.Died:Connect(function() stop("helicopter") end)
		say("Helicopter on. E / Q = up / down.")
	end

