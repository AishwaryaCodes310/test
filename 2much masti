	local TXT, MUT = SAIKIUI.text, SAIKIUI.mut
	local WHITE = Color3.new(1, 1, 1)
	local INK = Color3.fromRGB(18, 18, 20)
	local SOFT_INK = Color3.fromRGB(78, 78, 86)
	local RED = Color3.fromRGB(255, 92, 92)
	local ORANGE = Color3.fromRGB(255, 170, 64)
	local GREEN = Color3.fromRGB(78, 229, 154)
