	----------------------------------------------------------------- song helpers
	local function videoId(u)
		u = tostring(u or "")
		local id = u:match("[?&]v=([%w_%-]+)") or u:match("youtu%.be/([%w_%-]+)") or u:match("/shorts/([%w_%-]+)")
			or u:match("/embed/([%w_%-]+)") or u:match("/live/([%w_%-]+)")
		if not id and #u == 11 and u:match("^[%w_%-]+$") then id = u end
		if id then return id:sub(1, 11) end
		return nil
	end
	local function watchUrl(id) return "https://www.youtube.com/watch?v=" .. id end
	local function looksLikeLink(s) return s:lower():find("youtu") ~= nil and videoId(s) ~= nil end
	local function mkSong(name, url, tag)
		local id = videoId(url)
		if not id then return nil end
		return { name = tostring(name or "Unknown"), url = watchUrl(id), id = id, tag = tag }
	end
	local function isLiked(song) return song and D.liked[song.id] ~= nil end

	----------------------------------------------------------------- database (fetched dynamically from GitHub)
	local DB = { cats = {}, order = {}, ready = false, loading = false, err = nil }
	local function ingestDatabase(data)
		local cats = {}
		local src = type(data) == "table" and data.categories
		if type(src) ~= "table" then return false end
		for cname, arr in pairs(src) do
			if type(arr) == "table" then
				local out = {}
				for _, s in ipairs(arr) do
					if type(s) == "table" then
						local song = mkSong(s.name, s.url, tostring(cname))
						if song then out[#out + 1] = song end
					end
				end
				cats[tostring(cname)] = out
			end
		end
		local order, seen = {}, {}
		for _, k in ipairs(MUSIC.CATEGORY_ORDER) do
			if cats[k] then order[#order + 1] = k seen[k] = true end
		end
		local rest = {}
		for k in pairs(cats) do if not seen[k] then rest[#rest + 1] = k end end
		table.sort(rest)
		for _, k in ipairs(rest) do order[#order + 1] = k end
		DB.cats, DB.order, DB.ready = cats, order, true
		return true
	end
	local onDatabase -- set later (rebuilds the Library)
	local function loadDatabase(force)
		if DB.loading then return end
		DB.loading, DB.err = true, nil
		task.spawn(function()
			-- cached copy first, so the Library is usable instantly
			local cachedFresh = false
			pcall(function()
				if CAN_FILES and isfile(DB_FILE) then
					local c = HttpService:JSONDecode(readfile(DB_FILE))
					if type(c) == "table" and c.data and ingestDatabase(c.data) then
						cachedFresh = (os.time() - (tonumber(c.t) or 0)) < MUSIC.DB_REFRESH_SECONDS
					end
				end
			end)
			if DB.ready and onDatabase then pcall(onDatabase) end
			if cachedFresh and not force then DB.loading = false return end
			if not REQ then
				DB.loading = false
				if not DB.ready then DB.err = "Your executor has no request function, so the song database can't load." end
				if onDatabase then pcall(onDatabase) end
				return
			end
			local ok, res = pcall(REQ, { Url = MUSIC.SONG_DB_URL, Method = "GET" })
			local good = false
			if ok and res and res.Body and (res.StatusCode == nil or res.StatusCode == 200) then
				local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
				if ok2 and ingestDatabase(data) then
					good = true
					pcall(function()
						if CAN_FILES then writefile(DB_FILE, HttpService:JSONEncode({ t = os.time(), data = data })) end
					end)
				end
			end
			if not good and not DB.ready then DB.err = "Couldn't load the song database. Check your connection and press Refresh." end
			DB.loading = false
			if onDatabase then pcall(onDatabase) end
		end)
	end

	----------------------------------------------------------------- player state
	local snd = new("Sound", { Name = "SaikiMusic", Volume = D.volume, RollOffMaxDistance = 1e6 }, SoundService)
	local P = {
		queue = {}, idx = 0, token = 0, status = "idle", err = nil,
		history = {}, failStreak = 0, trackName = "Nothing playing", trackSub = "Pick a song from your library",
	}
	local ui = {} -- filled when the cards exist
	local refreshAll, refreshLibrary, refreshQueue, refreshNow -- forward declarations

	local function current() return P.queue[P.idx] end

	-- broadcast: only moderators / music admins, only while the mode is "Broadcast"
	local function isBroadcaster()
		return D.mode == "broadcast" and HOST.Music ~= nil and HOST.Music.canBroadcast ~= nil and HOST.Music.canBroadcast() == true
	end
	local function bc(cmd, song)
		if P.fromRemote or not isBroadcaster() or not HOST.Music.send then return end
		local text = "!saikimusic " .. cmd
		if song then
			local nm = tostring(song.name or ""):gsub("%c", " ")
			text = text .. " " .. song.id .. " " .. clip(nm, 90)
		end
		task.spawn(function() pcall(HOST.Music.send, text) end)
	end

	local function trimCache()
		pcall(function()
			if not (listfiles and delfile) then return end
			local files = listfiles(CACHE)
			if #files <= MUSIC.CACHE_MAX_FILES then return end
			local keep = current() and current().id
			-- no timestamps are exposed, so drop arbitrary extras (never the song playing now)
			local extra = #files - MUSIC.CACHE_MAX_FILES
			for _, f in ipairs(files) do
				if extra <= 0 then break end
				if not (keep and f:find(keep, 1, true)) then pcall(delfile, f) extra -= 1 end
			end
		end)
	end

	----------------------------------------------------------------- audio servers
	local function serverList()
		local list = { { type = "savenow" } }
		if D.server ~= "" then
			local s = D.server
			local kind = s:lower():find("/streams") and "piped" or "cobalt"
			list[#list + 1] = { type = kind, url = s, key = D.serverKey ~= "" and D.serverKey or nil }
		end
		return list
	end

	local function download(url)
		local ok, res = pcall(REQ, { Url = url, Method = "GET" })
		if ok and res and res.Body and #res.Body > 20000 and (res.StatusCode == nil or res.StatusCode == 200) then
			return res.Body
		end
		return nil
	end

	-- TATrMusic engine ---------------------------------------------------------
	local SN = { keyIdx = 1 }
	local function urlEnc(s)
		return (tostring(s):gsub("([^%w%-%._~])", function(c) return string.format("%%%02X", c:byte()) end))
	end
	local function snGet(url)
		local ok, res = pcall(REQ, { Url = url, Method = "GET" })
		if not ok then return nil, tostring(res):sub(1, 80) end
		if type(res) ~= "table" then return nil, "empty answer" end
		local status = tonumber(res.StatusCode or res.Status or res.status_code)
		local body = res.Body or res.body
		if status and (status < 200 or status >= 300) then return nil, "HTTP " .. tostring(status) end
		if type(body) ~= "string" or body == "" then return nil, "empty answer" end
		return body
	end
	local function snJson(body)
		if not body then return nil end
		local ok, data = pcall(function() return HttpService:JSONDecode((body:match("^%s*(.-)%s*$"))) end)
		return ok and type(data) == "table" and data or nil
	end

	-- returns audio bytes (string) or nil, reason
	local function snFetch(id, token)
		local keys = MUSIC.SAVENOW_KEYS
		local jobId, lastErr
		for _ = 1, #keys do
			if token ~= P.token then return nil, "cancelled" end
			if SN.keyIdx < 1 or SN.keyIdx > #keys then SN.keyIdx = 1 end
			local url = MUSIC.SAVENOW_BASE .. "download.php?url=" .. urlEnc(watchUrl(id)) .. "&format=mp3&apikey=" .. urlEnc(keys[SN.keyIdx])
				.. "&add_info=1&allow_extended_duration=1&no_merge=0"
			local body, err = snGet(url)
			local data = snJson(body)
			if data and data.id and not (data.error and data.error ~= "") then jobId = data.id break end
			lastErr = (data and (tostring(data.error or data.message or ""))) or err or "no answer"
			if lastErr == "" then lastErr = "no download id" end
			SN.keyIdx = (SN.keyIdx % #keys) + 1
			task.wait(0.8)
		end
		if not jobId then return nil, "audio service: " .. tostring(lastErr) end

		local dlUrl
		local deadline = os.clock() + MUSIC.SAVENOW_TIMEOUT
		while os.clock() < deadline do
			if token ~= P.token then return nil, "cancelled" end
			local data = snJson((snGet(MUSIC.SAVENOW_BASE .. "progress.php?id=" .. urlEnc(tostring(jobId)))))
			if data then
				local progress = tonumber(data.progress) or 0
				local percent = math.clamp(math.floor(progress > 100 and progress / 10 or progress), 0, 100)
				if P.progress ~= percent then
					P.progress = percent
					if refreshNow then pcall(refreshNow) end
				end
				if data.error and data.error ~= "" then return nil, tostring(data.error) end
				if progress >= 1000 and type(data.download_url) == "string" and data.download_url ~= "" then
					if data.success == true or tonumber(data.success) == 1 then dlUrl = data.download_url break end
					if data.success == false or tonumber(data.success) == 0 then return nil, tostring(data.message or "audio processing failed") end
				end
			end
			task.wait(1.5)
		end
		if not dlUrl then return nil, "the audio service took too long" end
		if token ~= P.token then return nil, "cancelled" end
		local body, err = snGet(dlUrl)
		if not body or #body < 2000 then return nil, "download failed" .. (err and (" (" .. err .. ")") or "") end
		return body
	end

	-- returns audio bytes (string) or nil, reason
	local function fetchFromServer(server, id, token)
		local why
		if server.type == "savenow" then return snFetch(id, token) end
		if server.type == "cobalt" then
			local headers = { ["Content-Type"] = "application/json", Accept = "application/json" }
			if server.key then headers.Authorization = "Api-Key " .. server.key end
			local ok, res = pcall(REQ, {
				Url = server.url, Method = "POST", Headers = headers,
				Body = HttpService:JSONEncode({ url = watchUrl(id), downloadMode = "audio", audioFormat = "mp3", audioBitrate = "128" }),
			})
			if not (ok and res and res.Body) then return nil, "no answer from server" end
			local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
			if not ok2 or type(data) ~= "table" then return nil, "bad answer from server" end
			if data.url and (data.status == "tunnel" or data.status == "redirect" or data.status == "stream") then
				local body = download(data.url)
				if body then return body end
				return nil, "download failed"
			end
			why = data.error and (type(data.error) == "table" and data.error.code or tostring(data.error)) or tostring(data.status or "refused")
			return nil, why
		elseif server.type == "piped" then
			local base = server.url:gsub("/+$", ""):gsub("/streams.*$", "")
			local ok, res = pcall(REQ, { Url = base .. "/streams/" .. id, Method = "GET" })
			if not (ok and res and res.Body) then return nil, "no answer from server" end
			local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
			if not ok2 or type(data) ~= "table" or type(data.audioStreams) ~= "table" then return nil, "no audio streams" end
			-- prefer formats Roblox can read (mp3 / ogg), then m4a; lowest bitrate that is still decent
			local best, bestScore
			for _, a in ipairs(data.audioStreams) do
				local mt = tostring(a.mimeType or ""):lower()
				local score = mt:find("mpeg") and 0 or mt:find("ogg") and 1 or mt:find("mp4") and 2 or 9
				local br = tonumber(a.bitrate) or 0
				if a.url and not a.videoOnly and score < 9 then
					local s = score * 1e7 + math.abs(br - 128000)
					if not bestScore or s < bestScore then best, bestScore = a, s end
				end
			end
			if not best then return nil, "no playable stream" end
			local body = download(best.url)
			if body then return body end
			return nil, "download failed"
		end
		return nil, "unknown server type"
	end

	-- wait until a Sound has really loaded (TimeLength > 0)
	local function waitLoaded(sound, token)
		local t0 = os.clock()
		while os.clock() - t0 < MUSIC.LOAD_TIMEOUT do
			if token ~= P.token then return false end
			if sound.IsLoaded and sound.TimeLength > 0 then return true end
			task.wait(0.1)
		end
		return false
	end

	local function setStatus(status, err)
		P.status, P.err = status, err
		if refreshNow then pcall(refreshNow) end
	end

	-- cover picture (best effort, never blocks the music)
	local function loadCover(song, token)
		task.spawn(function()
			pcall(function()
				if not CAN_AUDIO then return end
				local path = CACHE .. "/" .. song.id .. ".jpg"
				if not isfile(path) then
					local ok, res = pcall(REQ, { Url = "https://i.ytimg.com/vi/" .. song.id .. "/mqdefault.jpg", Method = "GET" })
					if not (ok and res and res.Body and #res.Body > 500) then return end
					writefile(path, res.Body)
				end
				if token == P.token and ui.cover then ui.cover.Image = getcustomasset(path) ui.coverNote.Visible = false end
			end)
		end)
	end

	local function playCurrent()
		local song = current()
		if not song then return end
		P.token += 1
		local token = P.token
		bc("play", song)
		P.progress = nil
		P.status = "loading" -- set first: stopping the old song must not look like "song finished"
		pcall(function() snd:Stop() end)
		snd.SoundId = ""
		P.trackName, P.trackSub = song.name, song.tag or "YouTube"
		if ui.cover then ui.cover.Image = "" ui.coverNote.Visible = true end
		if not CAN_AUDIO then
			setStatus("error", "Your executor can't play songs (needs request, writefile and getcustomasset).")
			return
		end
		setStatus("loading")
		if refreshQueue then pcall(refreshQueue) end
		loadCover(song, token)
		task.spawn(function()
			local path = CACHE .. "/" .. song.id .. ".mp3"
			local lastWhy = "no audio server worked"
			local function tryFile()
				local ok, asset = pcall(getcustomasset, path)
				if not ok or not asset then return false end
				snd.SoundId = asset
				if waitLoaded(snd, token) then return true end
				return false
			end
			local ready = false
			if isfile(path) then ready = tryFile() end
			if token ~= P.token then return end
			if not ready then
				pcall(function() if isfile(path) and delfile then delfile(path) end end)
				for _, server in ipairs(serverList()) do
					if token ~= P.token then return end
					local body, why = fetchFromServer(server, song.id, token)
					if token ~= P.token then return end
					if body then
						local okw = pcall(writefile, path, body)
						if okw and tryFile() then ready = true break end
						pcall(function() if delfile and isfile(path) then delfile(path) end end)
						lastWhy = "the audio file couldn't be read"
					else
						lastWhy = why or lastWhy
					end
				end
			end
			if token ~= P.token then return end
			if not ready then
				P.failStreak += 1
				setStatus("error", "Couldn't load this song (" .. tostring(lastWhy) .. "). If it keeps failing, add a backup audio server in the Playback card.")
				-- after a failure, move on once so a bad song doesn't stop the whole queue (max 3 in a row)
				if P.failStreak < 3 and #P.queue > 1 then
					task.delay(1.5, function()
						if token == P.token and P.status == "error" and ui.next then ui.next(true) end
					end)
				end
				return
			end
			P.failStreak = 0
			snd.Volume = D.volume
			snd.TimePosition = 0
			snd:Play()
			setStatus("playing")
			trimCache()
		end)
	end

	local function pushHistory(i)
		P.history[#P.history + 1] = i
		if #P.history > 60 then table.remove(P.history, 1) end
	end

	local function playIndex(i, noHistory)
		if not P.queue[i] then return end
		if P.idx > 0 and not noHistory and P.idx ~= i then pushHistory(P.idx) end
		P.idx = i
		playCurrent()
		if refreshNow then pcall(refreshNow) end
		if refreshLibrary then pcall(refreshLibrary, true) end
	end

	-- list = songs, start = which one to play first (the whole visible list becomes the queue)
	local function playList(list, start)
		local q = {}
		local startSong = list[start]
		for i, s in ipairs(list) do
			if i > MUSIC.MAX_QUEUE then break end
			q[#q + 1] = s
		end
		P.queue, P.history = q, {}
		local i = 1
		for k, s in ipairs(q) do if s == startSong then i = k break end end
		P.idx = 0
		playIndex(i, true)
		if refreshQueue then pcall(refreshQueue) end
	end

	local function playOne(song)
		playList({ song }, 1)
	end

	local function addToQueue(song)
		if #P.queue >= MUSIC.MAX_QUEUE then return end
		P.queue[#P.queue + 1] = song
		if P.idx == 0 then playIndex(#P.queue, true) end
		if refreshQueue then pcall(refreshQueue) end
	end

	local function stepNext(auto)
		local n = #P.queue
		if n == 0 then return end
		if auto == true and D.repeatMode == 2 then playIndex(P.idx, true) return end
		if D.shuffle and n > 1 then
			local j = P.idx
			while j == P.idx do j = math.random(1, n) end
			playIndex(j)
			return
		end
		local j = P.idx + 1
		if j > n then
			if D.repeatMode == 1 or auto ~= true then j = 1
			else
				P.idx = n
				P.status = "idle"
				pcall(function() snd:Stop() end)
				setStatus("idle")
				return
			end
		end
		playIndex(j)
	end
	ui.next = stepNext

	local function stepPrev()
		local n = #P.queue
		if n == 0 then return end
		if snd.TimePosition > 3 then snd.TimePosition = 0 return end
		if #P.history > 0 then
			local j = table.remove(P.history)
			playIndex(j, true)
			return
		end
		local j = P.idx - 1
		if j < 1 then j = n end
		playIndex(j, true)
	end

	local function togglePlay()
		if #P.queue == 0 then return end
		if P.status == "error" or P.status == "idle" then
			playCurrent()
		elseif snd.Playing then
			snd:Pause()
			setStatus("paused")
			bc("pause")
		else
			snd:Resume()
			setStatus("playing")
			bc("resume")
		end
	end

	snd.Ended:Connect(function()
		if P.status == "playing" then stepNext(true) end
	end)

	-- a moderator is broadcasting to this server: do what they do (never re-broadcast it)
	HOST.Music = HOST.Music or {}
	HOST.Music.onRemote = function(uid, text)
		if D.hear == false or not (HOST.Music.isAdmin and HOST.Music.isAdmin(uid)) then return end
		local cmd, rest = text:match("^!saikimusic%s+(%S+)%s*(.*)$")
		if cmd == "play" then
			local id, name = rest:match("^([%w_%-]+)%s*(.*)$")
			if not id or #id ~= 11 then return end
			local song = mkSong(name ~= "" and name or "Broadcast", watchUrl(id), "Broadcast")
			if not song then return end
			P.fromRemote = true
			pcall(playOne, song)
			P.fromRemote = false
		elseif cmd == "pause" then
			if snd.Playing then snd:Pause() setStatus("paused") end
		elseif cmd == "resume" then
			if P.status == "paused" then snd:Resume() setStatus("playing") end
		elseif cmd == "stop" then
			P.token += 1
			P.status = "idle"
			pcall(function() snd:Stop() end)
			setStatus("idle")
		end
	end

	----------------------------------------------------------------- likes / saved
	local function setLiked(song, on)
		if not song then return end
		if on then D.liked[song.id] = { name = song.name, url = song.url }
		else D.liked[song.id] = nil end
		saveData()
		if refreshLibrary then pcall(refreshLibrary, true) end
		if refreshNow then pcall(refreshNow) end
		if refreshQueue then pcall(refreshQueue) end
	end
	local function isSaved(id)
		for _, s in ipairs(D.saved) do
			if videoId(s.url) == id then return true end
		end
		return false
	end
	local function saveSong(name, url)
		local id = videoId(url)
		if not id then return false, "That doesn't look like a YouTube link." end
		name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
		if name == "" then return false, "Give the song a name." end
		for _, s in ipairs(D.saved) do
			if videoId(s.url) == id then s.name = name return true, "Updated “" .. clip(name, 28) .. "”." end
		end
		D.saved[#D.saved + 1] = { name = name, url = watchUrl(id) }
		saveData()
		return true, "Saved “" .. clip(name, 28) .. "”."
	end
	local function removeSaved(id)
		for i, s in ipairs(D.saved) do
			if videoId(s.url) == id then table.remove(D.saved, i) break end
		end
		saveData()
	end

	----------------------------------------------------------------- YouTube search (your own API key)
	local YT = { results = {}, query = "", busy = false, msg = nil }
	local function ytSearch(q, done)
		if D.apiKey == "" then YT.msg = "Add your YouTube API key first (card on the right)." if done then done() end return end
		if not REQ then YT.msg = "Your executor has no request function." if done then done() end return end
		YT.busy, YT.msg, YT.query = true, nil, q
		if done then done() end
		task.spawn(function()
			local url = "https://www.googleapis.com/youtube/v3/search?part=snippet&type=video&maxResults=25&q="
				.. HttpService:UrlEncode(q) .. "&key=" .. HttpService:UrlEncode(D.apiKey)
			local ok, res = pcall(REQ, { Url = url, Method = "GET" })
			local results = {}
			YT.msg = nil
			if ok and res and res.Body then
				local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
				if ok2 and type(data) == "table" then
					if data.error then
						local m = tostring(data.error.message or "error")
						if m:lower():find("quota") then m = "Your daily YouTube quota is used up. Try again tomorrow." end
						if m:lower():find("api key") then m = "YouTube says this API key isn't valid." end
						YT.msg = clip(m, 120)
					elseif type(data.items) == "table" then
						for _, it in ipairs(data.items) do
							local vid = it.id and it.id.videoId
							if vid and it.snippet then
								local s = mkSong(decodeEntities(it.snippet.title), watchUrl(vid), decodeEntities(it.snippet.channelTitle or "YouTube"))
								if s then results[#results + 1] = s end
							end
						end
						if #results == 0 then YT.msg = "No results for “" .. clip(q, 30) .. "”." end
					end
				else
					YT.msg = "Couldn't read YouTube's answer."
				end
			else
				YT.msg = "Couldn't reach YouTube."
			end
			YT.results, YT.busy = results, false
			if ui.onYT then pcall(ui.onYT) end
		end)
	end

