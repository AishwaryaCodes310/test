				if D.apiKey == "" then msg.Text = "Paste a key first." msg.TextColor3 = WARN return end
				msg.Text, msg.TextColor3 = "Testing…", MUT
				task.spawn(function()
					local ok, res = pcall(REQ, { Url = "https://www.googleapis.com/youtube/v3/search?part=snippet&type=video&maxResults=1&q=test&key=" .. HttpService:UrlEncode(D.apiKey), Method = "GET" })
					local good, text = false, "Couldn't reach YouTube."
					if ok and res and res.Body then
						local ok2, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
