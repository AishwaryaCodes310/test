	------------------------------------------------------------- SKY STYLES page
	local function period(h)
		if h < 5.5 or h >= 19.5 then return "Night" end
		if h < 7.5 then return "Dawn" end
		if h >= 16.5 then return "Dusk" end
		return "Day"
	end
	local function hashOf(s)
		local h = 7
		for i = 1, #s do h = (h * 31 + string.byte(s, i)) % 100003 end
		return h
	end

	-- draws a small picture of the sky style (or shows your uploaded cover image)
	local function buildCover(parent, name)
		for _, ch in ipairs(parent:GetChildren()) do
			if ch:IsA("GuiObject") or ch:IsA("UIGradient") then ch:Destroy() end
		end
		local id = COVER_IDS[name]
		if id and id ~= "" then
			new("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = "rbxassetid://" .. id, ScaleType = Enum.ScaleType.Crop }, parent)
			return
		end
		local pr = SKY_PRESETS[name]
		if not pr then return end
		local hr = pr.hour or 12
		local night = hr < 5.5 or hr >= 19.5
		local twi = (not night) and (hr < 7.5 or hr >= 16.5)
		local top, bot
		if night then
			top = pr.adec:Lerp(Color3.new(0, 0, 0), 0.55)
			bot = pr.acol:Lerp(Color3.new(0, 0, 0), 0.45)
		elseif twi then
			top = pr.adec:Lerp(Color3.fromRGB(40, 40, 90), 0.5)
			bot = pr.acol
		else
			top = pr.acol:Lerp(Color3.fromRGB(80, 130, 225), 0.3)
			bot = pr.adec:Lerp(WHITE, 0.1)
		end
		parent.BackgroundColor3 = WHITE
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(top, bot) }, parent)
		local rng = Random.new(hashOf(name))
		local function box(x, y, w, h, c, tr, round)
			local f = new("Frame", { Position = UDim2.fromScale(x, y), Size = UDim2.fromScale(w, h), BackgroundColor3 = c, BackgroundTransparency = tr or 0, BorderSizePixel = 0 }, parent)
			if round then new("UICorner", { CornerRadius = UDim.new(0, 999) }, f) end
			return f
		end
		-- soft colour clouds of gas on hazy nights (galaxy, nebula, neon...)
		if night and pr.haze >= 0.8 then
			box(rng:NextNumber(0, 0.3), rng:NextNumber(0, 0.2), 0.6, 0.8, pr.ccol, 0.82, true)
			box(rng:NextNumber(0.4, 0.6), rng:NextNumber(0.1, 0.3), 0.5, 0.7, pr.acol, 0.84, true)
		end
		-- stars
		if (night or twi) and pr.stars > 0 then
			local n = math.floor(math.clamp(pr.stars / 330, 3, 18))
			if not night then n = math.floor(n / 2) end
			for _ = 1, n do
				local sz = rng:NextInteger(1, 2)
				local f = box(rng:NextNumber(0.03, 0.97), rng:NextNumber(0.04, 0.55), 0, 0, WHITE, rng:NextNumber(0, 0.5), true)
				f.Size = UDim2.fromOffset(sz, sz)
			end
