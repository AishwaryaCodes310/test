			local g = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y), Size = UDim2.fromOffset(d * glow, d * glow), BackgroundColor3 = c, BackgroundTransparency = 0.84, BorderSizePixel = 0 }, parent)
			new("UICorner", { CornerRadius = UDim.new(0, 999) }, g)
			local m = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y), Size = UDim2.fromOffset(d, d), BackgroundColor3 = c, BorderSizePixel = 0 }, parent)
			new("UICorner", { CornerRadius = UDim.new(0, 999) }, m)
		end
		if hr >= 18.5 or hr < 5.5 then
			local d = math.clamp(10 + (pr.moon or 11) * 0.55, 14, 34)
