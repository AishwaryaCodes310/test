	local function trim(x) x = x:gsub("^%s+", ""); x = x:gsub("%s+$", ""); return x end

	-- moderator names (GitHub, one per line) -> userIds (Roblox API, cached on disk so it also works offline)
	local function loadMods()
		local list
		if REQUEST and CONFIG.MODS_URL and CONFIG.MODS_URL ~= "" then
			local ok, res = pcall(REQUEST, { Url = CONFIG.MODS_URL, Method = "GET" })
			if ok and type(res) == "table" and (tonumber(res.StatusCode or res.Status) or 0) == 200 then
				list = {}
				for line in tostring(res.Body or res.body or ""):gmatch("[^\r\n]+") do
					local nm = trim(line)
					if nm:match("^[%w_]+$") and #nm >= 3 and #nm <= 20 then list[#list + 1] = nm end
				end
			end
		end
		local cache = {}
		pcall(function()
			if isfile and readfile and isfile(MODFILE) then
				local d = HttpService:JSONDecode(readfile(MODFILE))
				if type(d) == "table" and type(d.ids) == "table" then cache = d.ids end
			end
		end)
		local out = {}
		if list then
			T.modNames = list
			for _, nm in ipairs(list) do
				local low = nm:lower()
				local id
				if low == LP.Name:lower() then
					id = string.format("%.0f", LP.UserId)
				else
					local ok, res = pcall(function() return Players:GetUserIdFromNameAsync(nm) end)
					id = (ok and res) and string.format("%.0f", res) or cache[low]
				end
				if id then out[low] = id end
			end
			pcall(function() if writefile then writefile(MODFILE, HttpService:JSONEncode({ ids = out, t = os.time() })) end end)
		else
