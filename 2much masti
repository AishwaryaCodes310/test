local function dockCardX(name)
    for _, col in ipairs(HOST.Cols) do
        for _, c in ipairs(col.cards) do
            if c.frame.Name == name then return c.frame.Position.X.Offset end
        end
    end
    return nil
end

local dockOn = {}
local function paintDock()
    if not HOST_DOCK then return end
    local pos = Scroll.CanvasPosition.X
    local vw = Scroll.AbsoluteSize.X
    local maxX = math.max(0, Scroll.CanvasSize.X.Offset - vw)
    local probe = pos + math.min(vw * 0.3, 260)
    local active, lastShown
    for i, it in ipairs(DOCK_ITEMS) do
        local x = dockCardX(it[2])
        dockBtns[i].Visible = x ~= nil
        if x then
            lastShown = i
            if x - PAD_X - 10 <= probe then active = i end
        end
    end
    if maxX > 0 and pos >= maxX - 4 and lastShown then active = lastShown end
    for i, b in ipairs(dockBtns) do
        local on = (i == active)
        -- Novoline: the highlight fades between tabs instead of snapping
        if dockOn[i] ~= on then
            local first = dockOn[i] == nil
            dockOn[i] = on
            local goal = {
                BackgroundTransparency = on and 0 or 1,
                TextColor3 = on and Color3.fromRGB(18, 18, 20) or HOST.Th.mut,
            }
            if first then
                for k, val in pairs(goal) do b[k] = val end
            else
                tween(b, 0.24, goal)
            end
        end
    end
end
HOST.OnScroll[#HOST.OnScroll + 1] = paintDock

function HOST.LayoutDock(compact, dockH)
    Dock.Size = UDim2.fromOffset(0, dockH)
    Dock.Position = UDim2.new(0.5, 0, 1, compact and -8 or -14)
    HOST._dockBase = Dock.Position
    for _, b in ipairs(dockBtns) do b.TextSize = compact and 11 or 12 end
end

