	-- everything moderators did, one small read: kicks, mutes, custom titles, secret frames
	local function parseMods(data)
		local mute, title, granted = {}, {}, {}
		local nowms = nowMs()
		for target, byMap in pairs(data.mute or {}) do
			local tid = tostring(target)
			if type(byMap) == "table" and not T.isMod(tid) then
				for by, rec in pairs(byMap) do
					if T.isMod(by) and type(rec) == "table" then
						local u = tonumber(rec["until"]) or 0
						if u == 0 or u > nowms then
							local prev = mute[tid]
							if prev == nil then mute[tid] = u elseif prev ~= 0 and (u == 0 or u > prev) then mute[tid] = u end
						end
					end
				end
			end
		end
		for target, byMap in pairs(data.title or {}) do
			local best, bt = nil, -1
			if type(byMap) == "table" then
				for by, rec in pairs(byMap) do
					if T.isMod(by) and type(rec) == "table" and type(rec.t) == "string" and rec.t ~= "" then
						local ts = tonumber(rec.ts) or 0
						if ts > bt then best, bt = rec.t, ts end
					end
				end
			end
			if best then title[tostring(target)] = best:sub(1, 24) end
		end
		for target, fmap in pairs(data.frame or {}) do
			if type(fmap) == "table" then
				for fkey, byMap in pairs(fmap) do
