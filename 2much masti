			local function allSongs()
				local out, seen = {}, {}
				for _, s in ipairs(D.saved) do
					local song = mkSong(s.name, s.url, "Saved")
					if song and not seen[song.id] then seen[song.id] = true out[#out + 1] = song end
				end
				for _, cname in ipairs(DB.order) do
					for _, song in ipairs(DB.cats[cname]) do
						if not seen[song.id] then seen[song.id] = true out[#out + 1] = song end
					end
				end
				for id, l in pairs(D.liked) do
					if not seen[id] then
						seen[id] = true
						local song = mkSong(l.name, l.url, "Liked")
						if song then out[#out + 1] = song end
					end
				end
				return out
			end

			local function songsForView()
				local base
				if view == "All" then base = allSongs()
				elseif view == "Liked" then
					base = {}
					for id, l in pairs(D.liked) do
						local song = mkSong(l.name, l.url, "Liked")
						if song then base[#base + 1] = song end
					end
					table.sort(base, function(a, b) return a.name:lower() < b.name:lower() end)
				elseif view == "Saved" then
					base = {}
					for _, s in ipairs(D.saved) do
						local song = mkSong(s.name, s.url, "Saved")
						if song then base[#base + 1] = song end
					end
				elseif view == "YouTube" then base = YT.results
				else base = DB.cats[view] or {} end
				-- search filter (song name)
				local q = query:lower():gsub("^%s+", ""):gsub("%s+$", "")
				if q ~= "" and view ~= "YouTube" then
					local f = {}
					for _, s in ipairs(base) do
						if s.name:lower():find(q, 1, true) then f[#f + 1] = s end
					end
					base = f
				end
				-- liked songs always float to the top
				local liked, rest = {}, {}
				for _, s in ipairs(base) do
					if isLiked(s) then liked[#liked + 1] = s else rest[#rest + 1] = s end
				end
				for _, s in ipairs(rest) do liked[#liked + 1] = s end
				return liked
			end

			local function setView(v)
