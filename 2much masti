	local function stop(name)
		local a = active[name]
		if not a then return end
		active[name] = nil
		for _, c in ipairs(a.conns) do pcall(function() c:Disconnect() end) end
		if a.undo then pcall(a.undo) end
		paintTile(name)
		if refreshNow then refreshNow() end
	end
	local function begin(name, undo)
		stop(name)
		local a = { conns = {}, undo = undo }
		active[name] = a
		paintTile(name)
		if refreshNow then refreshNow() end
		return a
	end
