					if c:IsA("GuiObject") then c:Destroy() end
				end
				note.Visible = false
				-- database status line
				if DB.loading and not DB.ready then ui.dbStatus.Text = "Loading songs…"
				elseif DB.err then ui.dbStatus.Text = "Database offline"
				else
					local n = 0
					for _, arr in pairs(DB.cats) do n += #arr end
					ui.dbStatus.Text = DB.ready and (n .. " songs · " .. #DB.order .. " categories") or ""
				end
				local order = 0
				-- paste a YouTube link = play it
				if looksLikeLink(query) then
					local id = videoId(query)
					order += 1
					local row = new("TextButton", { AutoButtonColor = false, Text = "", LayoutOrder = order, Size = UDim2.new(1, -4, 0, 38), BackgroundColor3 = Color3.fromRGB(40, 22, 28), BorderSizePixel = 0 }, list)
					rc(row, 10)
					txt(row, "▶  Play this link", 12, true, TXT, 12, 0, 250, 38)
					local linkSong = mkSong("YouTube " .. id, query, "Pasted link")
					row.Activated:Connect(function() if linkSong then playOne(linkSong) end end)
					button(row, "+", 326, 5, 28, 28, BTN, TXT, function() if linkSong then addToQueue(linkSong) end end, 15)
				elseif query:gsub("%s", "") ~= "" and view ~= "YouTube" then
					order += 1
					local row = new("TextButton", { AutoButtonColor = false, Text = "", LayoutOrder = order, Size = UDim2.new(1, -4, 0, 34), BackgroundColor3 = BTN, BorderSizePixel = 0 }, list)
					rc(row, 10)
					local hasKey = D.apiKey ~= ""
					txt(row, hasKey and ("Search YouTube for “" .. clip(query, 30) .. "”") or "Add an API key to search all of YouTube →", 11, true, hasKey and TXT or MUT, 12, 0, 340, 34)
					row.Activated:Connect(function()
