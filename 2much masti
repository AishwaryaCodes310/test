							setView("YouTube")
							ytSearch(query, function() refreshLibrary() end)
						elseif ui.keyCard then
							HOST.ScrollTo(ui.keyCard.Position.X.Offset - 20)
						end
					end)
				end

				if view == "YouTube" then
					if D.apiKey == "" then
						note.Text = "YouTube search needs your own free API key.\nSet it up in the YouTube search card →"
						note.Visible = true
					elseif YT.busy then
						note.Text = "Searching YouTube…"
						note.Visible = true
					elseif YT.msg then
						note.Text = YT.msg
						note.Visible = true
					elseif #YT.results == 0 then
						note.Text = "Type a song name above and press Enter\nto search YouTube."
						note.Visible = true
					end
				end

				local songs = songsForView()
				if #songs == 0 and not note.Visible then
					if not DB.ready and DB.loading then note.Text = "Loading the song database…"
					elseif not DB.ready and DB.err then note.Text = DB.err
					elseif view == "Liked" then note.Text = "No liked songs yet.\nTap ♥ on any song."
					elseif view == "Saved" then note.Text = "No saved songs yet.\nUse the “Save a song” card →"
					elseif query ~= "" then note.Text = "No songs match “" .. clip(query, 30) .. "”."
					else note.Text = "Nothing here yet." end
					note.Visible = true
				end
				for i, song in ipairs(songs) do
					if i > limit then
						order += 1
						local more = new("TextButton", { AutoButtonColor = false, Text = "Show more (" .. (#songs - limit) .. " left)", TextSize = 11, TextColor3 = MUT, LayoutOrder = order, Size = UDim2.new(1, -4, 0, 30), BackgroundColor3 = BTN, BorderSizePixel = 0 }, list)
