			view.notice(ok and ("Your music permission for " .. shown .. " is removed. If another moderator also allowed them, they keep the tab until that one is removed too.") or ("Couldn't remove it (HTTP " .. tostring(code) .. ")."))
		elseif cmd == "!giveframe" then
			local fword, off = rest:match("^(%S+)%s*(%S*)$")
