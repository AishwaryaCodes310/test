				local liked = isLiked(song)
				button(row, "♥", 262, 5, 28, 28, liked and Color3.fromRGB(46, 22, 30) or BTN, liked and RED or MUT, function() setLiked(song, not isLiked(song)) end, 14)
				button(row, "+", 294, 5, 28, 28, BTN, TXT, function() addToQueue(song) end, 15)
				if view == "Saved" or song.tag == "Saved" then
					button(row, "×", 326, 5, 28, 28, BTN, WARN, function() removeSaved(song.id) refreshLibrary(true) end, 15)
				elseif not isSaved(song.id) then
					button(row, "Save", 326, 5, 38, 28, BTN, MUT, function()
						saveSong(song.name, song.url)
						refreshLibrary(true)
					end, 10)
