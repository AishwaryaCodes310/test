					local b = button(chips, name, 0, 0, w, 24, BTN, MUT, function() setView(name) end, 11)
					b.LayoutOrder = i
					b.Size = UDim2.fromOffset(w, 24)
					chipBtns[name] = b
				end
				for name, b in pairs(chipBtns) do
