	local function tint(k)
		if k >= 0.6 then return ORANGE:Lerp(GREEN, math.min((k - 0.6) / 0.2, 1)) end
		if k >= 0.3 then return RED:Lerp(ORANGE, (k - 0.3) / 0.3) end
		return RED
	end
	local function stats(p)
		local c = p.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		if not h or h.Health <= 0 then return "Waiting for respawn", 0 end
		local k = 1
		if h.MaxHealth > 0 and h.MaxHealth < 1e9 then k = math.clamp(h.Health / h.MaxHealth, 0, 1) end
		local parts = {}
		local mr, tr = root(LP.Character), root(c)
		if mr and tr then
			local d = math.floor((mr.Position - tr.Position).Magnitude + 0.5)
			parts[1] = d .. (d == 1 and " stud" or " studs")
		end
		if h.Health < 1e9 then parts[#parts + 1] = math.ceil(h.Health) .. " HP" end
		return table.concat(parts, "  ·  "), k
	end

