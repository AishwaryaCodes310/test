-- THEMES: the Theme picker (Settings > Appearance) calls this. It restyles everything the host owns: the card bodies and
-- rims, the dock, the top capsule, the scroll bar and the dimmed background. Panels/text inside the cards are recoloured
-- by the picker itself.
function HOST.SetTheme(th, instant)
    local Th, old = HOST.Th, {}
    for k, v in pairs(Th) do old[k] = v end
    for _, f in ipairs(HOST.ThemeHooks) do pcall(f, th) end
    for _, k in ipairs({ "cardA", "cardB", "rim", "shine", "accA", "mut", "text", "tri", "dim", "field", "btn" }) do
        if th[k] ~= nil then Th[k] = th[k] end
    end
    local function put(o, goal)
        if not o then return end
        if instant then
            for k, v in pairs(goal) do o[k] = v end
        else
            tween(o, 0.5, goal)
        end
    end
    local bodies = {}
    for _, col in ipairs(HOST.Cols) do
        for _, c in ipairs(col.cards) do
            local f = c.frame
            put(f:FindFirstChildOfClass("UIStroke"), { Color = Th.rim })
            put(c.shine and c.shine:FindFirstChild("Fill"), { BackgroundColor3 = Th.shine })
            local g = f:FindFirstChild("Body")
            if g then bodies[#bodies + 1] = g end
        end
    end
    put(Dock, { BackgroundColor3 = Th.cardA })
    put(Dock:FindFirstChildOfClass("UIStroke"), { Color = Th.rim })
    for _, b in ipairs(dockBtns) do put(b, { BackgroundColor3 = Th.accA }) end
    put(Toggle, { BackgroundColor3 = Th.cardA })
    put(Toggle:FindFirstChildOfClass("UIStroke"), { Color = Th.rim })
    put(tri, { TextColor3 = Th.tri })
    put(triName, { TextColor3 = Th.text })
    put(Scroll, { ScrollBarImageColor3 = Th.accA })
    if HOST.Dim then put(HOST.Dim, { BackgroundColor3 = Th.dim }) end
    dockOn = {}
    paintDock()
    -- gradients can't be tweened: blend the card bodies frame by frame
    local function blend(e)
        local a, b = old.cardA:Lerp(Th.cardA, e), old.cardB:Lerp(Th.cardB, e)
        for _, g in ipairs(bodies) do
            if g.Parent then g.Color = ColorSequence.new(a, b) end
        end
    end
    if instant then
        blend(1)
    else
        task.spawn(function()
            local t0 = os.clock()
            while true do
                local f = math.clamp((os.clock() - t0) / 0.5, 0, 1)
                blend(f * f * (3 - 2 * f))
                if f >= 1 then break end
                RunService.Heartbeat:Wait()
            end
        end)
    end
end

local function fxPlay(obj, info, props)
    local ok, tw = pcall(function() return TweenService:Create(obj, info, props) end)
    if ok and tw then
        tw:Play()
        return tw
    end
    return nil
end

local INFO_HOVER = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local INFO_DOWN = TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local INFO_UP = TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local INFO_GLOW = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PRESS_MAX_W, PRESS_MAX_H = 360, 96 -- bigger buttons (whole-card hit areas) are left alone

-- hover lift + press squish for one button (Novoline: kit.softButton / _nv_pressable)
function FX.hook(btn)
    if btn:GetAttribute("FXHooked") or btn:GetAttribute("NoPress") or btn.Name == "DragHandle" then return end
    btn:SetAttribute("FXHooked", true)
    local lift, press

    local function fits()
        local s = btn.AbsoluteSize
        return s.X >= 4 and s.Y >= 4 and s.X <= PRESS_MAX_W and s.Y <= PRESS_MAX_H
    end
    local function ghost() -- invisible hit-area buttons get no effect
        if btn.BackgroundTransparency < 1 then return false end
        if btn:IsA("TextButton") and btn.Text ~= "" then return false end
        if btn:IsA("ImageButton") and btn.Image ~= "" then return false end
        return btn:FindFirstChildWhichIsA("GuiObject") == nil
    end

    btn.MouseEnter:Connect(function()
        if not fits() or ghost() then return end
        if btn:FindFirstChildWhichIsA("UIGridStyleLayout") then return end
        if not (lift and lift.Parent) then
            lift = Instance.new("Frame")
            lift.Name = "FXLift"
            lift.BackgroundColor3 = Color3.new(1, 1, 1)
            lift.BackgroundTransparency = 1
            lift.BorderSizePixel = 0
            lift.Size = UDim2.fromScale(1, 1)
            lift.ZIndex = btn.ZIndex + 1
            lift.Active = false
            pcall(function() lift.Interactable = false end)
            Instance.new("UICorner", lift)
            lift.Parent = btn
        end
        local src = btn:FindFirstChildOfClass("UICorner")
        local own = lift:FindFirstChildOfClass("UICorner")
        if own then own.CornerRadius = src and src.CornerRadius or UDim.new(0, 0) end
        fxPlay(lift, INFO_HOVER, { BackgroundTransparency = 0.94 })
    end)

    local function release()
        if press and press.Parent then fxPlay(press, INFO_UP, { Scale = 1 }) end
    end
    btn.MouseLeave:Connect(function()
        if lift and lift.Parent then fxPlay(lift, INFO_HOVER, { BackgroundTransparency = 1 }) end
        release()
    end)
    btn.InputBegan:Connect(function(input)
        local k = input.UserInputType
        if k ~= Enum.UserInputType.MouseButton1 and k ~= Enum.UserInputType.Touch then return end
        if not fits() or ghost() then return end
        if not (press and press.Parent) then
            if btn:FindFirstChildOfClass("UIScale") then return end -- the button already scales itself
            press = Instance.new("UIScale")
            press.Name = "FXPress"
            press.Parent = btn
        end
        fxPlay(press, INFO_DOWN, { Scale = 0.95 })
    end)
    btn.InputEnded:Connect(function(input)
        local k = input.UserInputType
        if k == Enum.UserInputType.MouseButton1 or k == Enum.UserInputType.Touch then release() end
    end)
end

-- soft glow under a button that brightens on hover (Novoline's ButtonGlow)
function FX.glow(btn, rest, hover)
    local shadow
    pcall(function()
        local s = Instance.new("UIShadow") -- not available on every client: then only the rim brightens
        s.Name = "FXGlow"
        s.Color = Color3.new(1, 1, 1)
        s.BlurRadius = UDim.new(0, 10)
        s.Offset = UDim2.fromOffset(0, 1)
        s.Transparency = rest
        s.Parent = btn
        shadow = s
    end)
    local stroke = btn:FindFirstChildOfClass("UIStroke")
    local strokeRest = stroke and stroke.Transparency or 1
    if shadow then
        local function sync() pcall(function() shadow.Enabled = btn.BackgroundTransparency < 0.6 end) end
        sync()
        btn:GetPropertyChangedSignal("BackgroundTransparency"):Connect(sync)
    end
    btn.MouseEnter:Connect(function()
        if shadow then fxPlay(shadow, INFO_GLOW, { Transparency = hover }) end
        if stroke then fxPlay(stroke, INFO_GLOW, { Transparency = math.max(0, strokeRest - 0.3) }) end
    end)
    btn.MouseLeave:Connect(function()
        if shadow then fxPlay(shadow, INFO_GLOW, { Transparency = rest }) end
        if stroke then fxPlay(stroke, INFO_GLOW, { Transparency = strokeRest }) end
    end)
end

-- slowly drifting gradient on a label (Novoline's _nv_micro.gradientText)
function FX.gradientText(label, speed)
    speed = math.max(0.2, speed or 8)
    local white = Color3.fromRGB(246, 246, 248)
    local grad = Instance.new("UIGradient")
    grad.Name = "FXLiveGradient"
    grad.Parent = label
    label.TextColor3 = Color3.new(1, 1, 1)

    local set, setKey
    local function palette()
        local a = HOST.AccentA
        if set and a == setKey then return set end
        setKey = a
        if typeof(a) ~= "Color3" then
            set = { white, Color3.fromRGB(196, 196, 206), white }
        else
            local h, s = a:ToHSV()
            local soft = Color3.fromHSV(h, math.min(s, 0.55), 1)
            set = { white, white:Lerp(soft, 0.55), white:Lerp(soft, 0.25) }
        end
        return set
    end
    local function colorAt(p, g)
        g = g % 300
        local i = math.floor(g / 100)
        local f = g / 100 - i
        return p[i + 1]:Lerp(p[(i + 1) % 3 + 1], f)
    end

    local clock, lastOff, lastKey = 0, nil, nil
    local gAcc = 0
    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not label.Parent then
            conn:Disconnect()
            return
        end
        if not HOST.Sheet.Visible then return end
        clock += dt
        gAcc += dt
        if gAcc < 0.066 then return end
        gAcc = 0
        local swing = (clock / speed) % 2
        local t = swing < 1 and swing or 2 - swing
        local off = math.floor((0.5 - math.cos(math.pi * t) / 2) * 2000 + 0.5) / 10
        local p = palette()
        if off == lastOff and setKey == lastKey then return end
        lastOff, lastKey = off, setKey
        local keys = { ColorSequenceKeypoint.new(0, colorAt(p, off)) }
        local edge = (math.floor(off / 100) + 1) * 100
        local u = (edge - off) / 100
        if u > 0.001 and u < 0.999 then
            keys[#keys + 1] = ColorSequenceKeypoint.new(u, colorAt(p, edge))
        end
        keys[#keys + 1] = ColorSequenceKeypoint.new(1, colorAt(p, off + 100))
        grad.Color = ColorSequence.new(keys)
    end)
    return grad
end

-- while the sheet is open (Novoline): game + Roblox GUI hidden, background darkened, FOV widened.
-- Everything is put back exactly as it was when the sheet is hidden.
local Env = { on = false }
HOST.Env = Env
do
    local StarterGui = game:GetService("StarterGui")
    local DIM_T, FOV_ADD = 0.6, 15 -- background transparency while open / extra field of view
    local dim = Instance.new("Frame")
    dim.Name = "SaikiDim"
    dim:SetAttribute("HostTheme", true)
    dim.BackgroundColor3 = Color3.new(0, 0, 0)
    dim.BackgroundTransparency = 1
    dim.BorderSizePixel = 0
    dim.Size = UDim2.fromScale(1, 1)
    dim.ZIndex = 0
    dim.Active = false
    pcall(function() dim.Interactable = false end)
    dim.Parent = HOST.Gui
    HOST.Dim = dim

    local savedCore, savedGuis, savedFov, childConn = {}, {}, nil, nil
    local INFO_ENV = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

    local function hideGui(g)
        if g:IsA("ScreenGui") and g ~= HOST.Gui and g.Enabled then
            savedGuis[g] = true
            g.Enabled = false
        end
    end

    function Env.apply()
        if Env.on then return end
        Env.on = true
        fxPlay(dim, INFO_ENV, { BackgroundTransparency = DIM_T })
        -- Roblox's own GUI (leaderboard, backpack, chat, health...)
        table.clear(savedCore)
        for _, t in ipairs(Enum.CoreGuiType:GetEnumItems()) do
            if t ~= Enum.CoreGuiType.All then
                local ok, en = pcall(function() return StarterGui:GetCoreGuiEnabled(t) end)
                if ok and en then savedCore[#savedCore + 1] = t end
            end
        end
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false) end)
        -- the game's own GUIs (also ones that appear while we are open)
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, g in ipairs(pg:GetChildren()) do hideGui(g) end
            childConn = pg.ChildAdded:Connect(function(g) task.defer(hideGui, g) end)
        end
        -- wider field of view
        local cam = workspace.CurrentCamera
        if cam then
            savedFov = savedFov or cam.FieldOfView
            fxPlay(cam, INFO_ENV, { FieldOfView = math.min(120, savedFov + FOV_ADD) })
        end
    end

    function Env.restore()
        if not Env.on then return end
        Env.on = false
        fxPlay(dim, INFO_ENV, { BackgroundTransparency = 1 })
        if childConn then
            childConn:Disconnect()
            childConn = nil
        end
        for g in pairs(savedGuis) do
            if g.Parent then g.Enabled = true end
        end
        table.clear(savedGuis)
        for _, t in ipairs(savedCore) do
            pcall(function() StarterGui:SetCoreGuiEnabled(t, true) end)
        end
        table.clear(savedCore)
        local cam = workspace.CurrentCamera
        if cam and savedFov then fxPlay(cam, INFO_ENV, { FieldOfView = savedFov }) end
        task.delay(0.5, function()
            if not Env.on then savedFov = nil end
        end)
    end
    HOST.Gui.Destroying:Connect(function() Env.restore() end) -- script removed while open: undo too
end

-- pop-in / pop-out of the whole sheet (Novoline: pill.popIn / pill.popOut)
do
    local sheetScale = Instance.new("UIScale")
    sheetScale.Name = "FXSheetScale"
    sheetScale.Parent = HOST.Sheet
    HOST._dockBase = HOST._dockBase or Dock.Position

    local DOCK_BG, DOCK_RIM, SLIDE = 0.06, 0.86, 26
    local INFO_IN = TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    local INFO_FADE_IN = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local INFO_OUT = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    local token = 0

    local function dockRim() return Dock:FindFirstChildOfClass("UIStroke") end
    local function setTexts(v)
        pageTitle.TextTransparency = v
        pageSub.TextTransparency = v
        for _, b in ipairs(dockBtns) do b.TextTransparency = v end
    end
    local function tweenTexts(info, v)
        fxPlay(pageTitle, info, { TextTransparency = v })
        fxPlay(pageSub, info, { TextTransparency = v })
        for _, b in ipairs(dockBtns) do fxPlay(b, info, { TextTransparency = v }) end
    end

    function FX.popIn(force)
        if not FX_ENABLED then
            HOST.Sheet.Visible = true
            return
        end
        if HOST.Sheet.Visible and not FX.closing and not force then return end
        token += 1
        FX.closing = false
        HOST.Sheet.Visible = true
        sheetScale.Scale = 0.9
        fxPlay(sheetScale, INFO_IN, { Scale = 1 })
        setTexts(1)
        tweenTexts(INFO_FADE_IN, 0)
        local base = HOST._dockBase or Dock.Position
        Dock.Position = base + UDim2.fromOffset(0, SLIDE)
        Dock.BackgroundTransparency = 1
        fxPlay(Dock, INFO_FADE_IN, { Position = base, BackgroundTransparency = DOCK_BG })
        local rim = dockRim()
        if rim then
            rim.Transparency = 1
            fxPlay(rim, INFO_FADE_IN, { Transparency = DOCK_RIM })
        end
    end

    function FX.popOut()
        if not FX_ENABLED then
            HOST.Sheet.Visible = false
            return
        end
        if not HOST.Sheet.Visible then return end
        token += 1
        local mine = token
        FX.closing = true
        fxPlay(sheetScale, INFO_OUT, { Scale = 0.9 })
        tweenTexts(INFO_OUT, 1)
        local base = HOST._dockBase or Dock.Position
        fxPlay(Dock, INFO_OUT, { Position = base + UDim2.fromOffset(0, SLIDE), BackgroundTransparency = 1 })
        local rim = dockRim()
        if rim then fxPlay(rim, INFO_OUT, { Transparency = 1 }) end
        task.delay(0.25, function()
            if mine ~= token then return end -- reopened while it was closing
            FX.closing = false
            HOST.Sheet.Visible = false
            sheetScale.Scale = 1
            setTexts(0)
            Dock.Position = HOST._dockBase or base
            Dock.BackgroundTransparency = DOCK_BG
            local r = dockRim()
            if r then r.Transparency = DOCK_RIM end
        end)
    end
end

