						for by in pairs(byMap) do
							if T.isMod(by) then
								local tid = tostring(target)
								granted[tid] = granted[tid] or {}
								granted[tid][fkey] = true
							end
						end
					end
				end
			end
		end
		return mute, title, granted
	end

	-- a moderator kicked me (moderators themselves can't be kicked)
	local function checkKick(data)
		local recs = data.kick and data.kick[ME]
		if type(recs) ~= "table" or T.isMod(ME) then return end
		for by, rec in pairs(recs) do
			if T.isMod(by) and type(rec) == "table" then
				local ts = tonumber(rec.ts) or 0
				local key = tostring(by) .. ":" .. ts
				if ts > 0 and not handledKick[key] and nowMs() - ts < (CONFIG.MOD_KICK_TTL or 900) * 1000 then
					handledKick[key] = true
					local why = (type(rec.r) == "string" and rec.r ~= "") and ("\nReason: " .. rec.r:sub(1, 80)) or ""
					kick("You were kicked by a Saiki Rechat moderator." .. why)
					return
				end
			end
		end
	end

	local function pollMods()
		if not REQUEST or not ready then return end
		T.dmId()
		local ok, data = dbRequest("GET", "/mods", nil, dmAuth, DM_FIREBASE_DB)
		if not ok then return end
		if type(data) ~= "table" then data = {} end
		T.muted, T.customTitle, T.granted = parseMods(data)
		checkKick(data)
		if T.refreshFrames then pcall(T.refreshFrames) end
		if T.repaintTags then pcall(T.repaintTags) end
	end

	-------- commands
	local CMDS = { "!saikikick", "!saikianc", "!giveframe", "!saikicustomtitle", "!saikimute", "!musicallow", "!musicremove" }
	local function isCmd(w) for _, c in ipairs(CMDS) do if c == w then return true end end return false end

	-- username -> userId, also for players who are not in this server
	local function resolveUser(name)
		name = name:gsub("^@", "")
		local low = name:lower()
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Name:lower() == low or p.DisplayName:lower() == low then return string.format("%.0f", p.UserId), p.Name end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Name:lower():sub(1, #low) == low then return string.format("%.0f", p.UserId), p.Name end
		end
		local ok, id = pcall(function() return Players:GetUserIdFromNameAsync(name) end)
		if ok and id then return string.format("%.0f", id), name end
		return nil
	end

	local function secretKeys() -- names moderators can give with !giveframe
		local out = {}
		for k in pairs(CONFIG.FRAMES) do
			if k == "rose" or k == "cursed" or k == "demon" then out[#out + 1] = k
			elseif k:sub(1, 2) == "x_" then out[#out + 1] = k:sub(3) end
		end
		table.sort(out, function(a, b) return a:lower() < b:lower() end)
		return out
	end
	local function frameKeyOf(word)
		local low = word:lower()
		low = low:gsub("^x_", "")
		for k in pairs(CONFIG.FRAMES) do
			local kl = k:lower()
			if (k == "rose" or k == "cursed" or k == "demon") and kl == low then return k end
			if k:sub(1, 2) == "x_" and kl:sub(3) == low then return k end
		end
		return nil
	end

	local function put(path, body) T.dmId(); return dbRequest("PUT", path, body, dmAuth, DM_FIREBASE_DB) end
	local function del(path) T.dmId(); return dbRequest("DELETE", path, nil, dmAuth, DM_FIREBASE_DB) end

	local function runCmd(view, cmd, args)
		if cmd == "!saikianc" then
			if args == "" then view.notice("Usage: !saikianc your announcement"); return end
			view.sendText("!anc " .. args) -- shows in THIS server only; moderators skip the tier check
			return
		end
		local who, rest = args:match("^(%S+)%s*(.*)$")
		if not who then view.notice("Usage: " .. cmd .. " <username> ..."); return end
		local id, shown = resolveUser(who)
		if not id then view.notice('No Roblox user called "' .. who .. '".'); return end
		local me = ME
		local ok, code
		if cmd == "!saikikick" then
			if T.isMod(id) then view.notice("Moderators can't be kicked."); return end
			ok, _, _, code = put("/mods/kick/" .. id .. "/" .. me, { ts = SV, r = cut(rest, 60) })
			view.notice(ok and ("Kick sent for " .. shown .. ". It works whether or not they are in this server: they are removed as soon as their Saiki Rechat checks in (within " .. math.floor((CONFIG.MOD_KICK_TTL or 900) / 60) .. " min).")
				or ("Couldn't send the kick (HTTP " .. tostring(code) .. "). Publish the new DM rules?"))
		elseif cmd == "!saikimute" then
			if T.isMod(id) then view.notice("Moderators can't be muted."); return end
			local a = rest:lower()
			if a == "off" or a == "unmute" then
				ok, _, _, code = del("/mods/mute/" .. id .. "/" .. me)
				view.notice(ok and (shown .. " is unmuted (by you).") or ("Couldn't unmute (HTTP " .. tostring(code) .. ")."))
