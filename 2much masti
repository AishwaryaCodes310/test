	local function pulse()
		if not ringStroke then return end
		ringStroke.Color = RED
		ringStroke.Transparency = 0.1
		TweenService:Create(ringStroke, TweenInfo.new(0.7), { Color = WHITE, Transparency = 0.75 }):Play()
