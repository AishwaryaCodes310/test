	-- Smoke: realistic puffs (drag in, hold, exhale, then rest a few seconds) instead of a constant stream.
	-- Only you see the particles (they live on your own client).
	local smokePace = "Normal"
	local PACES = {
		Chill = { exhale = { 3.0, 4.5 }, rest = { 4.0, 7.0 } },
		Normal = { exhale = { 2.2, 3.2 }, rest = { 2.0, 4.0 } },
		Chain = { exhale = { 1.8, 2.5 }, rest = { 1.0, 2.0 } },
	}
	local function smokeStatus(text)
		local t = tiles.smoke
		if t and active.smoke then t.sub.Text = text end
	end
	local function smoke()
		local head = LP.Character and LP.Character:FindFirstChild("Head")
		if not head then say("No character.") return end
		local old = head:FindFirstChild("SaikiSmoke")
		if old then old:Destroy() end
		local attach = new("Attachment", { Name = "SaikiSmoke", Position = Vector3.new(0, -0.45, -0.6) }, head)
		local em = new("ParticleEmitter", {
			Texture = "rbxasset://textures/particles/smoke_main.dds",
			Color = ColorSequence.new(Color3.fromRGB(235, 235, 235)),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(0.6, 0.78), NumberSequenceKeypoint.new(1, 1) }),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 2.6) }),
			Rate = 0, Lifetime = NumberRange.new(1.4, 2.2), Speed = NumberRange.new(1.5, 3),
			SpreadAngle = Vector2.new(18, 18), Acceleration = Vector3.new(0, 1.6, 0), Drag = 1.5,
			RotSpeed = NumberRange.new(-30, 30), Rotation = NumberRange.new(0, 360),
			EmissionDirection = Enum.NormalId.Front,
		}, attach)
		local a = begin("smoke", function() pcall(function() attach:Destroy() end) end)
		local function nap(sec)
			local t = tick()
			while active.smoke == a and tick() - t < sec do task.wait(0.1) end
			return active.smoke == a
		end
		task.spawn(function()
			while active.smoke == a do
				if not attach.Parent then stop("smoke") break end
				local P = PACES[smokePace] or PACES.Normal
				smokeStatus("Inhaling...")
				if not nap(1.0 + math.random() * 0.6) then break end
				smokeStatus("Holding it in...")
				if not nap(0.6 + math.random() * 0.6) then break end
				-- exhale: a soft burst, then a stream that thins out
				smokeStatus("Exhaling...")
				local dur = P.exhale[1] + math.random() * (P.exhale[2] - P.exhale[1])
				pcall(function() em:Emit(8) end)
				local t0 = tick()
				while active.smoke == a do
					local t = tick() - t0
					if t >= dur then break end
					em.Rate = 4 + 42 * (1 - t / dur) ^ 0.8
					RunService.Heartbeat:Wait()
				end
				em.Rate = 0
				if active.smoke ~= a then break end
				local rest = P.rest[1] + math.random() * (P.rest[2] - P.rest[1])
				smokeStatus(string.format("Resting (%ds)", math.ceil(rest)))
				if not nap(rest) then break end
			end
		end)
	end

