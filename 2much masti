	local function flingSelf()
		local char = LP.Character
		local mr = root(char)
		if not mr then say("No character.") return end
		local saved = {}
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				saved[part] = { part.CustomPhysicalProperties, part.Massless, part.CanCollide }
				part.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5)
			end
		end
		local spin = new("BodyAngularVelocity", { Name = "SaikiFling", AngularVelocity = Vector3.new(0, 99999, 0), MaxTorque = Vector3.new(0, math.huge, 0), P = math.huge }, mr)
		for _, part in ipairs(char:GetChildren()) do if part:IsA("BasePart") then part.Massless = true end end
		local a = begin("fling", function()
			pcall(function() spin:Destroy() end)
			for part, was in pairs(saved) do
				if part.Parent then pcall(function() part.CustomPhysicalProperties = was[1] part.Massless = was[2] part.CanCollide = was[3] end) end
			end
			local r = root(LP.Character)
			if r then r.AssemblyLinearVelocity = Vector3.zero r.AssemblyAngularVelocity = Vector3.zero end
		end)
		a.conns[#a.conns + 1] = RunService.Stepped:Connect(function()
			for part in pairs(saved) do if part.Parent then part.CanCollide = false end end
		end)
		local flip, acc = false, 0
		a.conns[#a.conns + 1] = RunService.Heartbeat:Connect(function(dt)
			acc += dt
			if acc < 0.15 then return end
			acc = 0 flip = not flip
			spin.AngularVelocity = flip and Vector3.new(0, 99999, 0) or Vector3.zero
		end)
	end

	local function touchFling()
		local a = begin("touchfling", nil)
		task.spawn(function()
			local dir = 0.1
			while active.touchfling == a do
				RunService.Heartbeat:Wait()
				local mr = root(LP.Character)
				if mr then
					local v = mr.AssemblyLinearVelocity
					mr.AssemblyLinearVelocity = v * 10000 + Vector3.new(0, 10000, 0)
					RunService.RenderStepped:Wait()
					mr.AssemblyLinearVelocity = v
					RunService.Stepped:Wait()
					mr.AssemblyLinearVelocity = v + Vector3.new(0, dir, 0)
