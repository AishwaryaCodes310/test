				if k == "" then return "" end
				if #k <= 10 then return string.rep("•", #k) end
				return k:sub(1, 4) .. string.rep("•", 12) .. k:sub(-4)
			end
			local function paint()
				state.Text = D.apiKey ~= "" and "Key saved" or "No key yet"
